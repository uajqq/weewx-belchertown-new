#errorCatcher Echo
##
## All-time daily climatological data for the Reports page.
## Mirrors the $alltime.<obs>.series(...) pattern already proven working
## in DivumWX's chart-data template, but at daily resolution covering the
## entire archive (not just the current year). This lets the Reports page
## build NOAA-style monthly/yearly tables for any year on record, not just
## the current one.
##
## Each series is a parallel-array WeeWX series() result: inspect the
## actual output once generated to confirm key names (start/stop/data vs
## named-by-obstype) before wiring up the JS parser.
##
{
"outTempAvg":   $alltime.outTemp.series(aggregate_type='avg', aggregate_interval=86400, time_series='start', time_unit='unix_epoch_ms').round(1).json,
"outTempMax":   $alltime.outTemp.series(aggregate_type='max', aggregate_interval=86400, time_series='start', time_unit='unix_epoch_ms').round(1).json,
"outTempMin":   $alltime.outTemp.series(aggregate_type='min', aggregate_interval=86400, time_series='start', time_unit='unix_epoch_ms').round(1).json,
"rainDaily":    $alltime.rain.series(aggregate_type='sum', aggregate_interval=86400, time_series='start', time_unit='unix_epoch_ms').round(2).json,
"windSpeedAvg": $alltime.windSpeed.series(aggregate_type='avg', aggregate_interval=86400, time_series='start', time_unit='unix_epoch_ms').round(1).json,
"windGustMax":  $alltime.windGust.series(aggregate_type='max', aggregate_interval=86400, time_series='start', time_unit='unix_epoch_ms').round(1).json,
"windDirAvg":   $alltime.windDir.series(aggregate_type='avg', aggregate_interval=86400, time_series='start', time_unit='unix_epoch_ms').round(0).json
}
