// #if $Extras.has_key("forecast_enabled") and $Extras.forecast_enabled == '1'
var forecast_last_updated_epoch = null;
var forecast_relative_timer = null;
var forecast_refresh_timer = null;
var forecast_retry_timer = null;
var forecast_refresh_in_progress = false;
var forecast_last_fetch_ms = 0;
var forecast_resume_refresh_min_ms = 60000;
var forecast_retry_delay_ms = 15000;
var forecast_stale_retry_delay_ms = 60000;
var forecast_refresh_interval_seconds = 3540;
var forecast_current_conditions_refresh_interval_seconds = 3540;
var forecast_resume_events_bound = false;
var forecast_external_observations = {};
var forecast_observation_info_bound = false;
var forecast_station_observation_sources = $station_obs_source_json;
// Relative-time thresholds (minutes shown up to 59) are configured once in the
// Day.js setup block in new-belchertown-utils.js.
// #if $Extras.has_key("forecast_stale")
forecast_refresh_interval_seconds = "$Extras.forecast_stale";
// #end if
// #if $Extras.has_key("current_conditions_stale")
forecast_current_conditions_refresh_interval_seconds = "$Extras.current_conditions_stale";
// #end if

function forecast_refresh_seconds(value, fallback) {
    const seconds = parseFloat(value);
    return isFinite(seconds) && seconds > 0 ? seconds : fallback;
}

function forecast_refresh_interval_ms() {
    const forecastSeconds = forecast_refresh_seconds(forecast_refresh_interval_seconds, 3540);
    const currentConditionsSeconds = forecast_refresh_seconds(forecast_current_conditions_refresh_interval_seconds, 3540);
    return Math.max(Math.min(forecastSeconds, currentConditionsSeconds), 60) * 1000;
}

function forecast_payload_generated_at_ms(data) {
    if (!data || typeof data !== "object") {
        return null;
    }

    const value = data["generated_at"] || data["timestamp"];
    const epoch = parseFloat(value);
    if (!isFinite(epoch) || epoch <= 0) {
        return null;
    }

    // Normalized forecast payloads use epoch seconds. Retain compatibility
    // with a millisecond timestamp if a custom or legacy payload supplies one.
    return epoch > 100000000000 ? epoch : epoch * 1000;
}

function forecast_payload_is_stale(data) {
    const generatedAtMs = forecast_payload_generated_at_ms(data);
    if (generatedAtMs === null) {
        return false;
    }

    const staleAfterMs = forecast_refresh_seconds(forecast_refresh_interval_seconds, 3540) * 1000;
    return (Date.now() - generatedAtMs) >= staleAfterMs;
}

function forecast_json_url(filename) {
    return get_relative_url() + "/json/" + filename + "?_=" + Date.now();
}

function forecast_clear_retry_timer() {
    if (forecast_retry_timer !== null) {
        window.clearTimeout(forecast_retry_timer);
        forecast_retry_timer = null;
    }
}

function forecast_schedule_retry(delayMs) {
    if (forecast_retry_timer !== null || document.hidden) {
        return;
    }

    const parsedDelayMs = parseFloat(delayMs);
    const retryDelayMs = isFinite(parsedDelayMs) && parsedDelayMs > 0
        ? parsedDelayMs
        : forecast_retry_delay_ms;

    forecast_retry_timer = window.setTimeout(function() {
        forecast_retry_timer = null;
        ajaxforecast();
    }, retryDelayMs);
}

function forecast_fetch_json(filename) {
    return fetch(forecast_json_url(filename), {cache: "no-store"})
        .then(function(resp) {
            if (!resp.ok) {
                throw new Error("HTTP error! Unable to load " + filename);
            }
            return resp.json();
        })
        .then(function(data) {
            return {
                ok: true,
                filename: filename,
                data: data,
            };
        })
        .catch(function(err) {
            return {
                ok: false,
                filename: filename,
                error: err,
            };
        });
}

function ajaxforecast() {
    const nowMs = Date.now();
    forecast_bind_resume_events();
    forecast_start_refresh_timer();

    if (forecast_refresh_in_progress) {
        return Promise.resolve();
    }

    forecast_refresh_in_progress = true;
    forecast_last_fetch_ms = nowMs;

    return Promise.all([
        forecast_fetch_json("current_conditions.json"),
        forecast_fetch_json("forecast.json"),
    ])
        .then(function(results) {
            const currentResult = results[0];
            const forecastResult = results[1];
            const forecastPayloadIsStale = forecastResult.ok
                && forecast_payload_is_stale(forecastResult.data);
            const fallbackForecastData = forecastResult.ok
                ? forecastResult.data
                : (typeof forecast_data !== "undefined" ? forecast_data : {});

            if (currentResult.ok) {
                current_conditions_data = currentResult.data;
                update_current_conditions(currentResult.data, fallbackForecastData);
            } else {
                console.error("Forecast fetch failed:", currentResult.error);
            }

            if (forecastResult.ok) {
                forecast_data = forecastResult.data;
                update_forecast_data(forecastResult.data);
            } else {
                console.error("Forecast fetch failed:", forecastResult.error);
            }

            if (currentResult.ok && forecastResult.ok) {
                forecast_clear_retry_timer();
                // A successful request can still return the previous forecast
                // when this browser polls just before WeeWX regenerates the
                // JSON file. Retry soon instead of waiting another full stale
                // interval for the next regular poll.
                if (forecastPayloadIsStale) {
                    forecast_schedule_retry(forecast_stale_retry_delay_ms);
                }
                return true;
            }

            forecast_schedule_retry();
            return currentResult.ok || forecastResult.ok;
        })
        .catch(function(err) {
            console.error("Forecast render failed:", err);
            forecast_schedule_retry();
            return false;
        })
        .finally(function() {
            forecast_refresh_in_progress = false;
        });
}

function forecast_start_refresh_timer() {
    if (forecast_refresh_timer !== null) {
        return;
    }
    forecast_refresh_timer = window.setInterval(function() {
        if (!document.hidden) {
            ajaxforecast();
        }
    }, forecast_refresh_interval_ms());
}

function forecast_refresh_after_resume() {
    if (document.hidden) {
        return;
    }
    forecast_render_relative_timestamps();
    if (forecast_last_fetch_ms && (Date.now() - forecast_last_fetch_ms) < forecast_resume_refresh_min_ms) {
        return;
    }
    ajaxforecast();
}

function forecast_bind_resume_events() {
    if (forecast_resume_events_bound) {
        return;
    }
    forecast_resume_events_bound = true;

    document.addEventListener("visibilitychange", forecast_refresh_after_resume);
    window.addEventListener("focus", forecast_refresh_after_resume);
    window.addEventListener("pageshow", forecast_refresh_after_resume);
    window.addEventListener("online", forecast_refresh_after_resume);
}

function forecast_trim_sentence_end(value) {
    return belchertown_decode_html_entities(value).trim().replace(/[\.\s]+$/, "");
}

function forecast_label_text(value) {
    return belchertown_decode_html_entities(value).trim().replace(/\s+([.,;:!?])/g, "$1");
}

function forecast_sentence_text(parts) {
    const text = parts
        .map(forecast_trim_sentence_end)
        .filter(function(part) { return part !== ""; })
        .join(" ");
    return text ? text + "." : "";
}

function forecast_timestamp_label(value) {
    return forecast_trim_sentence_end(value).replace(/\s+(on|at)$/i, "");
}

function forecast_relative_time_locale_name() {
    let localeName;
    if (typeof window !== "undefined" && window.moment_locale) {
        localeName = window.moment_locale;
    } else if (typeof dayjs !== "undefined" && typeof dayjs.locale === "function") {
        localeName = dayjs.locale();
    }
    return localeName ? String(localeName).replace(/_/g, "-") : undefined;
}

function forecast_join_relative_time_parts(parts) {
    if (parts.length <= 1) {
        return parts[0] || "";
    }

    if (typeof Intl !== "undefined" && typeof Intl.ListFormat === "function") {
        try {
            return new Intl.ListFormat(forecast_relative_time_locale_name(), {
                style: "long",
                type: "conjunction",
            }).format(parts);
        } catch (e) {
            // Fall through to the plain join if the browser rejects the locale.
        }
    }

    return parts.join(" ");
}

// Day.js locales store relativeTime as a template map ("%d minutes") or, for
// some languages, per-key functions — handle both, mirroring what moment's
// localeData.relativeTime()/pastFuture() did.
function forecast_dayjs_locale_object() {
    return dayjs.Ls[dayjs.locale()] || dayjs.Ls.en;
}

function forecast_relative_time_unit(localeData, value, singularKey, pluralKey, isFuture) {
    const key = value === 1 ? singularKey : pluralKey;
    const template = localeData.relativeTime[key];
    if (typeof template === "function") {
        return template(value, true, key, isFuture);
    }
    return String(template).replace("%d", value);
}

function forecast_relative_time_past_future(localeData, diffMs, output) {
    const template = localeData.relativeTime[diffMs > 0 ? "future" : "past"];
    if (typeof template === "function") {
        return template(output);
    }
    return String(template).replace("%s", output);
}

function forecast_relative_time_hour_threshold() {
    // Matches the "hh" row of the Day.js relativeTime thresholds configured in
    // new-belchertown-utils.js (hours shown up to 21, i.e. moment's h:22).
    return 22;
}

function forecast_compound_relative_time(targetMoment, nowMoment) {
    const diffMs = targetMoment.diff(nowMoment);
    const absSeconds = Math.floor(Math.abs(diffMs) / 1000);
    const totalMinutes = Math.floor(absSeconds / 60);
    const hours = Math.floor(totalMinutes / 60);
    const minutes = totalMinutes % 60;
    const hourThreshold = forecast_relative_time_hour_threshold();

    if (hours < 1 || minutes === 0 || hours >= hourThreshold) {
        return targetMoment.from(nowMoment);
    }

    const localeData = forecast_dayjs_locale_object();
    if (!localeData || !localeData.relativeTime) {
        return targetMoment.from(nowMoment);
    }

    const isFuture = diffMs > 0;
    const parts = [
        forecast_relative_time_unit(localeData, hours, "h", "hh", isFuture),
        forecast_relative_time_unit(localeData, minutes, "m", "mm", isFuture),
    ];
    return forecast_relative_time_past_future(localeData, diffMs, forecast_join_relative_time_parts(parts));
}

function forecast_relative_time(epoch) {
    const timestamp = forecast_number(epoch);
    if (timestamp === null) {
        return "";
    }

    return forecast_compound_relative_time(tzAdjustedMoment(timestamp), tzAdjustedMoment(Date.now() / 1000));
}

function forecast_absolute_time(epoch, formatString) {
    const timestamp = forecast_number(epoch);
    return timestamp === null ? "" : tzAdjustedMoment(timestamp).format(belchertown_label_text(formatString));
}

function forecast_escape_html(value) {
    return belchertown_escape_html(value);
}

function forecast_template_text(template, replacements) {
    template = belchertown_decode_html_entities(template);
    var index = 0;
    return String(template || "").replace(/%s/g, function() {
        var value = replacements[index++];
        return belchertown_decode_html_entities(value);
    });
}

function forecast_template_html(template, replacements) {
    template = belchertown_decode_html_entities(template);
    replacements = replacements || [];

    var index = 0;
    return String(template || "").split("%s").map(function(part) {
        var html = forecast_escape_html(part);
        if (index < replacements.length) {
            html += replacements[index++];
        }
        return html;
    }).join("");
}

function forecast_provider_label(provider) {
    const providerKey = String(provider || "");
    if (providerKey === "nws") return "NWS";
    if (providerKey === "open-meteo") return "Open-Meteo";
    if (providerKey === "pirateweather") return "Pirate Weather";
    if (providerKey === "xweather") return "Xweather";
    if (providerKey === "aeris") return "Aeris/Xweather";
    return provider ? String(provider) : forecast_label_text("$obs.label.forecast_data");
}

function forecast_payload_source(data, fallbackProvider) {
    data = data || {};
    return forecast_provider_label(data["provider"] || fallbackProvider || "$Extras.forecast_provider");
}

function forecast_render_source(data) {
    const source = forecast_payload_source(data, "");
    const sourceText = forecast_sentence_text([forecast_label_text("$obs.label.source") + ": " + source]);
    const sourceTitle = forecast_label_text("$obs.label.forecast_source") + ": " + source;
    document.querySelectorAll(".forecast-source").forEach(function(el) {
        el.textContent = sourceText;
        el.setAttribute("title", sourceTitle);
    });
}

function forecast_current_observation_epoch(data) {
    const cc = data && data["current"] && data["current"][0] ? data["current"][0] : {};
    return forecast_number(cc["time"] || data["timestamp"] || data["generated_at"]);
}

function forecast_observation_label(row, fallback) {
    const labelCell = row.querySelector(".station-observations-label");
    if (!labelCell) {
        return fallback;
    }
    const clone = labelCell.cloneNode(true);
    clone.querySelectorAll(".observation-source-info").forEach(function(el) {
        el.remove();
    });
    return clone.textContent.trim() || fallback;
}

function forecast_observation_age_sentence(epoch) {
    const timestamp = forecast_number(epoch);
    if (timestamp === null) {
        return forecast_label_text("$obs.label.observation_time_unavailable");
    }

    return forecast_template_text("$obs.label.observation_time_reported", [forecast_relative_time(timestamp)]);
}

function forecast_ensure_observation_modal() {
    if (document.getElementById("observation-source-modal")) {
        return;
    }

    var modal = "";
    modal += "<div class='modal fade observation-source-modal' id='observation-source-modal' tabindex='-1' role='dialog' aria-labelledby='observation-source-modal-title'>";
    modal += "<div class='modal-dialog modal-sm' role='document'>";
    modal += "<div class='modal-content'>";
    modal += "<div class='modal-header'>";
    modal += "<h4 class='modal-title' id='observation-source-modal-title'>" + forecast_escape_html(forecast_label_text("$obs.label.observation_source")) + "</h4>";
    modal += "<button type='button' class='btn-close' data-bs-dismiss='modal' aria-label='" + forecast_escape_html(forecast_label_text("$obs.label.close")) + "'></button>";
    modal += "</div>";
    modal += "<div class='modal-body observation-source-modal-body'></div>";
    modal += "<div class='modal-footer'>";
    modal += "<button type='button' class='btn btn-primary' data-bs-dismiss='modal'>" + forecast_escape_html(forecast_label_text("$obs.label.close")) + "</button>";
    modal += "</div>";
    modal += "</div>";
    modal += "</div>";
    modal += "</div>";
    document.body.insertAdjacentHTML("beforeend", modal);
}

function forecast_render_observation_modal(observationKey) {
    const info = forecast_external_observations[observationKey];
    if (!info) {
        return;
    }

    const label = forecast_escape_html(info["label"]);
    const source = forecast_escape_html(info["source"]);
    const observedAt = forecast_absolute_time(info["epoch"], '$obs.label.time_current_conditions_last_updated');
    let body = "<p>" + forecast_template_html("$obs.label.observation_source_provider", ["<strong>" + label + "</strong>", source]) + "</p>";
    body += "<p>" + forecast_escape_html(forecast_observation_age_sentence(info["epoch"])) + "</p>";
    if (observedAt) {
        body += "<p class='observation-source-modal-time'>" + forecast_escape_html(observedAt) + "</p>";
    }

    const modal = document.getElementById("observation-source-modal");
    if (modal) {
        modal.dataset.observation = observationKey;
        const modalBody = modal.querySelector(".observation-source-modal-body");
        if (modalBody) {
            modalBody.innerHTML = body;
        }
    }
}

function forecast_bind_observation_info() {
    if (forecast_observation_info_bound) {
        return;
    }

    forecast_observation_info_bound = true;
    document.addEventListener("click", function(event) {
        const trigger = event.target.closest(".observation-source-info");
        if (!trigger) {
            return;
        }
        event.preventDefault();
        forecast_ensure_observation_modal();
        forecast_render_observation_modal(trigger.dataset.observation);
        bootstrap.Modal.getOrCreateInstance(document.getElementById("observation-source-modal")).show();
    });
}

function forecast_register_external_observation(observationKey, data, options) {
    options = options || {};
    let row = Array.prototype.find.call(
        document.querySelectorAll(".station-observations tr"),
        function(tr) { return tr.dataset.observation === observationKey; }
    ) || null;
    if (!row) {
        const obsCell = document.querySelector(".station-observations ." + observationKey);
        row = obsCell ? obsCell.closest("tr") : null;
    }
    if (!row) {
        return;
    }

    const label = forecast_observation_label(row, observationKey);
    const metadata = options["metadata"] || {};
    const sourceProvider = options["sourceProvider"] || metadata["provider"];
    const source = forecast_payload_source(data, sourceProvider);
    let observationEpoch = forecast_number(options["epoch"] || metadata["epoch"]);
    if (observationEpoch === null) {
        observationEpoch = forecast_current_observation_epoch(data);
    }

    forecast_external_observations[observationKey] = {
        label: label,
        source: source,
        epoch: observationEpoch
    };

    row.classList.add("station-observation-row", "station-observation-row--external");

    let button = row.querySelector(".observation-source-info");
    if (!button) {
        button = document.createElement("button");
        button.type = "button";
        button.className = "observation-source-info";
        button.innerHTML = "<i class='fa fa-info' aria-hidden='true'></i>";
        const labelCell = row.querySelector(".station-observations-label");
        if (labelCell) {
            labelCell.appendChild(button);
        }
    }

    button.dataset.observation = observationKey;
    button.setAttribute("aria-label", forecast_template_text("$obs.label.observation_source_information", [label]));
    button.setAttribute("title", forecast_template_text("$obs.label.observation_source_information", [label]));

    forecast_bind_observation_info();
}

function forecast_register_external_observations(sourceKey, data, options) {
    const observationSources = forecast_station_observation_sources || {};
    Object.keys(observationSources).forEach(function(observationKey) {
        let metadata = observationSources[observationKey] || {};
        if (metadata["source_key"] !== sourceKey) {
            return;
        }
        forecast_register_external_observation(observationKey, data, {
            metadata: metadata,
            sourceProvider: options && options["sourceProvider"],
            epoch: options && options["epoch"]
        });
    });
}

function forecast_render_relative_timestamps() {
    if (forecast_last_updated_epoch !== null) {
        const forecastLabel = forecast_timestamp_label("$obs.label.forecast_last_updated");
        const subtitleText = forecast_sentence_text([forecastLabel, forecast_relative_time(forecast_last_updated_epoch)]);
        const subtitleTitle = forecast_absolute_time(forecast_last_updated_epoch, '$obs.label.time_forecast_last_updated');
        document.querySelectorAll(".forecast-subtitle").forEach(function(el) {
            el.textContent = subtitleText;
            el.setAttribute("title", subtitleTitle);
        });
    }

    const observationModal = document.getElementById("observation-source-modal");
    const activeObservation = observationModal ? observationModal.dataset.observation : undefined;
    if (activeObservation) {
        forecast_render_observation_modal(activeObservation);
    }

    forecast_render_alert_states();

    if (typeof forecast_sync_row_height === "function") {
        forecast_sync_row_height();
    }
}

function forecast_start_relative_timer() {
    if (forecast_relative_timer !== null) {
        return;
    }
    forecast_relative_timer = window.setInterval(forecast_render_relative_timestamps, 30000);
}

function forecast_compact_alert_title(title) {
    if (title == null) {
        return forecast_label_text("$obs.label.alert");
    }

    var compactTitle = String(title).replace(/\s+/g, " ").trim();
    if (!compactTitle) {
        return forecast_label_text("$obs.label.alert");
    }

    var lowerTitle = compactTitle.toLowerCase();
    var markers = [
        " issued ",
        " updated ",
        " extended ",
        " continued ",
        " continues ",
        " remains in effect ",
        " in effect until ",
        " until ",
        " from ",
        " cancelled ",
        " canceled ",
    ];
    for (var markerIndex = 0; markerIndex < markers.length; markerIndex++) {
        var titleCutoff = lowerTitle.indexOf(markers[markerIndex]);
        if (titleCutoff > 0) {
            compactTitle = compactTitle.slice(0, titleCutoff).replace(/[ :\-]+$/, "");
            break;
        }
    }

    return compactTitle || forecast_label_text("$obs.label.alert");
}

function forecast_format_alert_time(timestamp) {
    if (timestamp == null || timestamp === "") {
        return "";
    }

    return tzAdjustedMoment(timestamp).format(belchertown_label_text('$obs.label.time_forecast_alert_expires'));
}

function forecast_format_alert_start_time(timestamp) {
    return forecast_format_alert_time(timestamp);
}

function forecast_alert_start_timestamp(alertObj) {
    var effectiveTimestamp = alertObj['effective'];
    var onsetTimestamp = alertObj['onset'];
    var effectiveEpoch = forecast_number(effectiveTimestamp);
    var onsetEpoch = forecast_number(onsetTimestamp);
    var nowEpoch = Date.now() / 1000;

    if (onsetEpoch !== null && onsetEpoch > nowEpoch && (effectiveEpoch === null || effectiveEpoch <= nowEpoch)) {
        return onsetTimestamp;
    }

    return effectiveTimestamp || onsetTimestamp;
}

function forecast_alert_in_effect_text(alertObj) {
    var startTimestamp = forecast_alert_start_timestamp(alertObj);
    var endTimestamp = alertObj['ends'] || alertObj['expires'];
    var startEpoch = forecast_number(startTimestamp);
    var startIsPast = startEpoch !== null && startEpoch <= (Date.now() / 1000);
    var startText = forecast_format_alert_start_time(startTimestamp);
    var endText = forecast_format_alert_time(endTimestamp);

    if (startText && endText) {
        if (startIsPast) {
            return forecast_label_text("$obs.label.alert_in_effect_since") + " " + startText + " " + forecast_label_text("$obs.label.alert_until") + " " + endText;
        }
        return forecast_label_text("$obs.label.alert_in_effect_starting") + " " + startText + " " + forecast_label_text("$obs.label.alert_until") + " " + endText;
    }
    if (startText) {
        if (startIsPast) {
            return forecast_label_text("$obs.label.alert_in_effect_since") + " " + startText;
        }
        return forecast_label_text("$obs.label.alert_in_effect_starting") + " " + startText;
    }
    if (endText) {
        return forecast_label_text("$obs.label.alert_in_effect") + " " + endText;
    }

    return "";
}

function forecast_alert_is_pending(alertObj) {
    var startEpoch = forecast_number(forecast_alert_start_timestamp(alertObj));
    return startEpoch !== null && startEpoch > (Date.now() / 1000);
}

function forecast_alert_start_sort_timestamp(alertObj) {
    return forecast_number(forecast_alert_start_timestamp(alertObj));
}

function forecast_alert_line_starts_section(line) {
    return /^[*\u2022-]\s+/.test(line)
        || /^[^:]{1,32}:\s+\S/.test(line)
        || /^[A-Z][A-Z /-]+\.{3}/.test(line);
}

function forecast_alert_body_html(description) {
    var normalizedDescription = String(description || "")
        .replace(/\r\n?/g, "\n")
        .trim();
    if (!normalizedDescription) {
        return "";
    }

    var paragraphs = [];
    var paragraphLines = [];
    function finishParagraph() {
        if (!paragraphLines.length) {
            return;
        }
        paragraphs.push(paragraphLines.join(" "));
        paragraphLines = [];
    }

    normalizedDescription.split("\n").forEach(function(line) {
        var trimmedLine = line.trim();
        if (!trimmedLine) {
            finishParagraph();
            return;
        }
        if (paragraphLines.length && forecast_alert_line_starts_section(trimmedLine)) {
            finishParagraph();
        }
        paragraphLines.push(trimmedLine);
    });
    finishParagraph();

    return paragraphs.map(function(paragraph) {
        return "<p>" + forecast_escape_html(paragraph) + "</p>";
    }).join("");
}

function forecast_render_alert_states() {
    document.querySelectorAll(".forecast-alert-badge").forEach(function(badge) {
        var alertTiming = forecast_alert_in_effect_text({
            "effective": badge.dataset.alertStart,
            "ends": badge.dataset.alertEnd
        });
        var isPending = forecast_alert_is_pending({"effective": badge.dataset.alertStart});
        badge.classList.toggle("forecast-alert-badge--pending", isPending);
        badge.classList.toggle("forecast-alert-badge--active", !isPending);
        badge.setAttribute("aria-label", badge.textContent + (alertTiming ? ", " + alertTiming : ""));
    });

    document.querySelectorAll(".forecast-alert-timing").forEach(function(timing) {
        timing.textContent = forecast_alert_in_effect_text({
            "effective": timing.dataset.alertStart,
            "ends": timing.dataset.alertEnd
        });
    });
}

function forecast_active_alert_modal() {
    return document.querySelector(".modal.in[id^='forecast-alert-'], .modal.show[id^='forecast-alert-']");
}

function forecast_alert_modal_by_id(id) {
    return id ? document.getElementById(id) : null;
}

function forecast_alert_modal_html(forecastAlertId, forecastAlertTitleId, alertData) {
    var modal = "";
    modal += "<!-- Forecast Alert Modal -->";
    modal += "<div class='modal fade forecast-alert-modal' id='" + forecastAlertId + "' tabindex='-1' role='dialog' aria-labelledby='" + forecastAlertTitleId + "'>";
    modal += "<div class='modal-dialog' role='document'>";
    modal += "<div class='modal-content'>";
    modal += "<div class='modal-header'>";
    modal += "<div class='forecast-alert-modal-heading'>";
    modal += "<h4 class='modal-title' id='" + forecastAlertTitleId + "'>" + forecast_escape_html(alertData["title"]) + "</h4>";
    modal += "<div class='forecast-alert-timing' data-alert-start='" + forecast_escape_html(alertData["start"]) + "' data-alert-end='" + forecast_escape_html(alertData["end"]) + "'>" + forecast_escape_html(alertData["timing"]) + "</div>";
    modal += "</div>";
    modal += "<button type='button' class='btn-close' data-bs-dismiss='modal' aria-label='" + forecast_escape_html(forecast_label_text("$obs.label.close")) + "'></button>";
    modal += "</div>";
    modal += "<div class='modal-body forecast-alert-modal-body'>";
    modal += alertData["body"];
    modal += "</div>";
    modal += "<div class='modal-footer'>";
    modal += "<button type='button' class='btn btn-primary' data-bs-dismiss='modal'>" + forecast_escape_html(forecast_label_text("$obs.label.close")) + "</button>";
    modal += "</div>";
    modal += "</div>";
    modal += "</div>";
    modal += "</div>";
    return modal;
}

function forecast_update_alert_modal(modal, forecastAlertTitleId, alertData) {
    modal.classList.add("forecast-alert-modal");
    modal.setAttribute("aria-labelledby", forecastAlertTitleId);
    var modalTitle = modal.querySelector(".modal-title");
    if (modalTitle) {
        modalTitle.id = forecastAlertTitleId;
        modalTitle.innerHTML = forecast_escape_html(alertData["title"]);
    }
    var modalTiming = modal.querySelector(".forecast-alert-timing");
    if (!modalTiming && modalTitle) {
        modalTiming = document.createElement("div");
        modalTiming.className = "forecast-alert-timing";
        modalTitle.insertAdjacentElement("afterend", modalTiming);
    }
    if (modalTiming) {
        modalTiming.dataset.alertStart = alertData["start"];
        modalTiming.dataset.alertEnd = alertData["end"];
        modalTiming.textContent = alertData["timing"];
    }
    var modalBody = modal.querySelector(".modal-body");
    if (modalBody) {
        modalBody.classList.add("forecast-alert-modal-body");
        modalBody.innerHTML = alertData["body"];
    }
}

function forecast_remove_stale_alert_modals(currentAlertIds, activeAlertId) {
    document.querySelectorAll(".forecast-alert-modal, .modal[id^='forecast-alert-']").forEach(function(modal) {
        var modalId = modal.id;

        if (currentAlertIds[modalId]) {
            return;
        }

        if (modalId === activeAlertId) {
            modal.addEventListener("hidden.bs.modal", function() {
                modal.remove();
            }, {once: true});
            return;
        }

        modal.remove();
    });
}

function show_forcast_alert(data) {
    belchertown_debug("Forecast: Updating alert data");
    var i, forecast_alerts, forecast_alert_title, forecast_alert_body;
    var forecast_alert_start, forecast_alert_end, forecast_alert_timing, forecast_alert_state;
    var alert_aria_label, alert_link;
    var activeAlertModal = forecast_active_alert_modal();
    var activeAlertId = (activeAlertModal && activeAlertModal.id) || "";
    var currentAlertIds = {};
    var alertContainer = document.querySelector(".wx-stn-alert-text");
    forecast_alerts = [];

    if (activeAlertModal && activeAlertModal.closest(".wx-stn-alert-text")) {
        document.body.appendChild(activeAlertModal);
    }

    // Empty the alert links from the previous run without removing any active modal node.
    if (alertContainer) {
        alertContainer.innerHTML = "";
    }

    if (Array.isArray(data['alerts'])) {
        for (i = 0; i < data['alerts'].length; i++) {
            const alertObj = data['alerts'][i] || {};
            const alertDescription = (alertObj['description'] == null)
                ? ""
                : String(alertObj['description']);
            forecast_alert_title = (alertObj['title'] == null)
                ? forecast_label_text("$obs.label.alert")
                : forecast_compact_alert_title(alertObj['title']);
            forecast_alert_body = forecast_alert_body_html(alertDescription);
            forecast_alert_start = forecast_alert_start_timestamp(alertObj) || "";
            forecast_alert_end = alertObj['ends'] || alertObj['expires'] || "";
            forecast_alert_timing = forecast_alert_in_effect_text(alertObj);
            forecast_alert_state = forecast_alert_is_pending(alertObj) ? "pending" : "active";
            forecast_alerts.push({
                "title": forecast_alert_title,
                "body": forecast_alert_body,
                "start": forecast_alert_start,
                "end": forecast_alert_end,
                "timing": forecast_alert_timing,
                "state": forecast_alert_state,
                "start_order": forecast_alert_start_sort_timestamp(alertObj),
                "source_order": i
            });
        }
    }

    forecast_alerts.sort(function(firstAlert, secondAlert) {
        if (firstAlert["state"] !== secondAlert["state"]) {
            return firstAlert["state"] === "active" ? -1 : 1;
        }
        if (firstAlert["start_order"] === null && secondAlert["start_order"] === null) {
            return firstAlert["source_order"] - secondAlert["source_order"];
        }
        if (firstAlert["start_order"] === null) {
            return 1;
        }
        if (secondAlert["start_order"] === null) {
            return -1;
        }
        return firstAlert["start_order"] - secondAlert["start_order"]
            || firstAlert["source_order"] - secondAlert["source_order"];
    });

    if (forecast_alerts.length > 0) {
        belchertown_debug("Forecast: There are " + forecast_alerts.length + " alert(s).");
        for (i = 0; i < forecast_alerts.length; i++) {

            var forecastAlertId = "forecast-alert-" + i;
            var forecastAlertTitleId = forecastAlertId + "-title";

            currentAlertIds[forecastAlertId] = true;
            alert_aria_label = forecast_alerts[i]["title"];
            if (forecast_alerts[i]["timing"]) {
                alert_aria_label += ", " + forecast_alerts[i]["timing"];
            }
            alert_link = "<a class='forecast-alert-badge forecast-alert-badge--" + forecast_alerts[i]["state"] + "' href='#" + forecastAlertId + "' data-alert-start='" + forecast_escape_html(forecast_alerts[i]["start"]) + "' data-alert-end='" + forecast_escape_html(forecast_alerts[i]["end"]) + "' data-bs-toggle='modal' data-bs-target='#" + forecastAlertId + "' aria-label='" + forecast_escape_html(alert_aria_label) + "'>" + forecast_escape_html(forecast_alerts[i]["title"]) + "</a>";
            if (alertContainer) {
                alertContainer.insertAdjacentHTML("beforeend", alert_link);
            }

            var forecast_alert_modal = forecast_alert_modal_by_id(forecastAlertId);
            if (forecast_alert_modal) {
                forecast_update_alert_modal(forecast_alert_modal, forecastAlertTitleId, forecast_alerts[i]);
            } else {
                document.body.insertAdjacentHTML("beforeend", forecast_alert_modal_html(forecastAlertId, forecastAlertTitleId, forecast_alerts[i]));
            }
        }
        document.querySelectorAll(".wx-stn-alert").forEach(function(el) {
            el.style.display = "block";
        });
    } else {
        belchertown_debug("Forecast: There are no forecast alerts");
        document.querySelectorAll(".wx-stn-alert").forEach(function(el) {
            el.style.display = "none";
        });
    }

    forecast_remove_stale_alert_modals(currentAlertIds, activeAlertId);
}

function forecast_aqi_translate(data) {
    if (data === "good") data = "$obs.label.aqi_good";
    else if (data === "low") data = "$obs.label.aqi_low";
    else if (data === "fair") data = "$obs.label.aqi_fair";
    else if (data === "moderate") data = "$obs.label.aqi_moderate";
    else if (data === "high") data = "$obs.label.aqi_high";
    else if (data === "usg") data = "$obs.label.aqi_usg";
    else if (data === "unhealthy") data = "$obs.label.aqi_unhealthy";
    else if (data === "poor") data = "$obs.label.aqi_poor";
    else if (data === "very unhealthy") data = "$obs.label.aqi_very_unhealthy";
    else if (data === "very poor") data = "$obs.label.aqi_very_poor";
    else if (data === "hazardous") data = "$obs.label.aqi_hazardous";
    else if (data === "extremely poor") data = "$obs.label.aqi_extremely_poor";
    else if (data === "very high") data = "$obs.label.aqi_very_high";
    else data = "$obs.label.aqi_unknown";

    return forecast_label_text(data);
}

function forecast_current_fallback_period(forecastData) {
    const sections = ["hourly", "threeHourly", "daily"];

    for (let s = 0; s < sections.length; s++) {
        const rows = (forecastData || {})[sections[s]] || [];
        if (rows.length && rows[0]) {
            return rows[0];
        }
    }

    return {};
}

function update_current_conditions(data, forecastData) {
    forecast_provider = "$Extras.forecast_provider";
    belchertown_debug("Current Conditions: Provider is " + forecast_provider);
    belchertown_debug("Current Conditions: Updating data");
    belchertown_debug(data);

    if (!data["current"] || !data["current"][0]) {
        belchertown_debug("Current Conditions: Missing normalized current data");
        return false;
    }

    try {
        const cc = data["current"][0];
        const fallbackPeriod = forecast_current_fallback_period(forecastData);
        const sourceProvider = data["provider"] || forecast_provider;
        let w34icon = resolveIconForProvider(cc["icon"] || "", sourceProvider);
        if (w34icon === "unknown" && cc["summary"]) {
            w34icon = resolveIconForProvider(cc["summary"], sourceProvider);
        }
        if (w34icon === "unknown" && fallbackPeriod["icon"]) {
            w34icon = resolveIconForProvider(fallbackPeriod["icon"], sourceProvider);
        }
        if (w34icon === "unknown" && fallbackPeriod["summary"]) {
            w34icon = resolveIconForProvider(fallbackPeriod["summary"], sourceProvider);
        }
        const wxicon = get_relative_url() + "/images/" + w34icon + ".png";
        const wxiconEl = document.getElementById("wxicon");
        if (wxiconEl) {
            wxiconEl.src = wxicon;
        }

        try {
            document.querySelectorAll(".current-obs-text").forEach(function(el) {
                el.innerHTML = cc["summary"] || fallbackPeriod["summary"] || "";
            });
        } catch (err) { /* silent */}

        try {
            document.querySelectorAll(".station-observations .visibility").forEach(function(el) {
                el.innerHTML = forecast_visibility_text(cc["visibility"], cc["visibilityQualifier"], data);
            });
        } catch (err) { /* silent */}

        forecast_register_external_observations("current_conditions", data);

    } catch (error) {
        belchertown_debug("Current Conditions: Normalized render failed: " + error);
    }
    return true;
}

function forecast_number(value) {
    const numberValue = parseFloat(value);
    return isFinite(numberValue) ? numberValue : null;
}

function forecast_temp_text(value) {
    const numberValue = forecast_number(value);
    return numberValue !== null ? numberValue.toFixed(0) + '&deg;' : 'N/A';
}

function forecast_plain_number_text(value) {
    const numberValue = forecast_number(value);
    return numberValue !== null ? numberValue.toFixed(0) : 'N/A';
}

function forecast_percent_text(value, fallback) {
    const numberValue = forecast_number(value);
    if (numberValue === null) return fallback || null;
    const percentValue = Math.abs(numberValue) <= 1 ? numberValue * 100 : numberValue;
    return percentValue.toFixed(0) + '%';
}

function forecast_base_unit_key(sourceData) {
    if (typeof BU_resolveForecastBase === "function") {
        if (sourceData && typeof sourceData === "object") {
            return BU_resolveForecastBase(sourceData);
        }
        if (sourceData) {
            return BU_resolveForecastBase({units: sourceData});
        }
        return BU_resolveForecastBase({units: "$Extras.forecast_units"});
    }

    const aliasMap = {imperial: "us", metric: "ca", metricwx: "si"};
    let forecastUnits = "$Extras.forecast_units";
    if (sourceData && typeof sourceData === "object" && sourceData["units"]) {
        forecastUnits = sourceData["units"];
    } else if (sourceData) {
        forecastUnits = sourceData;
    }
    forecastUnits = aliasMap[String(forecastUnits || "").trim().toLowerCase()] || String(forecastUnits || "").trim().toLowerCase();
    return (["us", "si", "ca", "uk2"].indexOf(forecastUnits) !== -1) ? forecastUnits : "us";
}

function forecast_visibility_unit_label(sourceData) {
    if (
        window.BU_UNIT_SWITCHER_ENABLED &&
        typeof BU_getSystem === "function" &&
        typeof BU_SYS !== "undefined"
    ) {
        const unitSystem = BU_SYS[BU_getSystem()];
        if (unitSystem && unitSystem.dl) {
            return unitSystem.dl;
        }
    }

    if (
        unit_label_array &&
        typeof unit_label_array === "object" &&
        unit_label_array.hasOwnProperty("visibility") &&
        unit_label_array["visibility"] != null
    ) {
        return String(unit_label_array["visibility"]);
    }

    const forecastUnits = forecast_base_unit_key(sourceData);
    return (forecastUnits === "si" || forecastUnits === "ca") ? "km" : "miles";
}

function forecast_wind_unit_label(sourceData) {
    if (
        window.BU_UNIT_SWITCHER_ENABLED &&
        typeof BU_getSystem === "function" &&
        typeof BU_SYS !== "undefined"
    ) {
        const unitSystem = BU_SYS[BU_getSystem()];
        if (unitSystem && unitSystem.sl) {
            return unitSystem.sl;
        }
    }

    const forecastUnits = forecast_base_unit_key(sourceData);
    if (forecastUnits === "si") {
        return "m/s";
    }
    if (forecastUnits === "ca") {
        return "km/h";
    }
    return "mph";
}

function forecast_visibility_number(value) {
    let visibilityQualifier = "";
    let visibilityValue = value;

    if (typeof value === "string") {
        const trimmedValue = value.trim();
        if (trimmedValue.charAt(0) === "<" || trimmedValue.charAt(0) === ">") {
            visibilityQualifier = trimmedValue.charAt(0);
            visibilityValue = trimmedValue.slice(1).trim();
        }
    }

    return {
        value: forecast_number(visibilityValue),
        qualifier: visibilityQualifier
    };
}

function forecast_visibility_display_value(value, sourceData) {
    if (
        !window.BU_UNIT_SWITCHER_ENABLED ||
        typeof BU_forecastToMetricWX !== "function" ||
        typeof BU_getSystem !== "function" ||
        typeof BU_SYS === "undefined"
    ) {
        return value;
    }

    const baseKey = forecast_base_unit_key(sourceData);
    const visibilityKm = BU_forecastToMetricWX("vis", value, baseKey);
    const unitSystem = BU_SYS[BU_getSystem()];
    if (visibilityKm === null || !unitSystem || typeof unitSystem.distance !== "function") {
        return value;
    }
    return unitSystem.distance(visibilityKm);
}

function forecast_visibility_text(value, qualifier, sourceData) {
    const parsedVisibility = forecast_visibility_number(value);
    const numberValue = parsedVisibility.value;
    if (numberValue === null) return "N/A";

    const rounding = (
        unit_rounding_array &&
        typeof unit_rounding_array === "object" &&
        unit_rounding_array.hasOwnProperty("visibility")
    ) ? unit_rounding_array["visibility"] : 2;
    const unitLabel = forecast_visibility_unit_label(sourceData);
    const displayValue = forecast_visibility_display_value(numberValue, sourceData);
    const visibilityQualifier = (qualifier === "<" || qualifier === ">") ? qualifier : parsedVisibility.qualifier;

    return visibilityQualifier + displayValue.toLocaleString(
        "$system_locale_js",
        {
            minimumFractionDigits: rounding,
            maximumFractionDigits: rounding
        }
    ) + (unitLabel ? " " + unitLabel : "");
}

function forecast_icon_url(iconValue) {
    const iconBase = resolveIconForProvider(iconValue || "unknown", "pirateweather");
    return get_relative_url() + "/images/" + iconBase + ".png";
}

function forecast_daily_link(timestamp) {
    var showDailyLink = "0";
    // #if $Extras.has_key("forecast_show_daily_forecast_link")
    showDailyLink = "$Extras.forecast_show_daily_forecast_link";
    // #end if
    if (showDailyLink != "1") return "";

    const linkMoment = tzAdjustedMoment(timestamp || (Date.now() / 1000));
    const link = "$Extras.forecast_daily_forecast_link"
        .replace("YYYY", linkMoment.format("YYYY"))
        .replace("MM", linkMoment.format("MM"))
        .replace("DD", linkMoment.format("DD"));
    return '<a href="' + link + '" target="_blank">' + forecast_escape_html(forecast_label_text("$obs.label.daily_forecast")) + '</a>';
}

function forecast_metric_rows(row) {
    var humidityMode = "0";
    // #if $Extras.has_key("forecast_show_humidity_dewpoint")
    humidityMode = "$Extras.forecast_show_humidity_dewpoint";
    // #end if

    let html = "";
    if (humidityMode == "1") {
        const humidityText = forecast_percent_text(row["humidity"]);
        if (humidityText !== null) {
            html += '<div><i class="wi wi-humidity rain-precip"></i> <span>' + humidityText + '</span></div>';
        }
    } else if (humidityMode == "2") {
        const dewPointText = forecast_temp_text(row["dewPoint"]);
        if (dewPointText != 'N/A') {
            html += '<div><i class="wi wi-raindrops rain-precip"></i> <span>' + dewPointText + '</span></div>';
        }
    }

    const snowDepth = forecast_number(row["snowDepth"]);
    if (snowDepth !== null && snowDepth > 0) {
        const snowUnit = row["snowUnit"] || "";
        html += '<div class="snow-precip">';
        html += '<img src="' + get_relative_url() + '/images/snowflake-icon-15px.png" alt="" width="15" height="15" loading="lazy" decoding="async"> <span>' + snowDepth.toFixed(0) + '<span> ' + snowUnit;
        html += '</div>';
    } else {
        const precipText = forecast_percent_text(row["precipProbability"], '0%');
        const rainClass = precipText == '0%' ? 'rain-no-precip' : 'rain-precip';
        html += '<div><i class="wi wi-raindrop wi-rotate-45 ' + rainClass + '"></i> <span>' + precipText + '</span></div>';
    }

    return html;
}

function forecast_wind_html(row, includeGust, sourceData) {
    const windSpeedText = forecast_plain_number_text(row["windSpeed"]);
    let html = '<div class="forecast-wind">';
    html += '<i class="wi wi-strong-wind"></i> <span class="forecast-wind-speed">' + windSpeedText + '</span>';
    if (includeGust) {
        const gustUnitLabel = forecast_wind_unit_label(sourceData);
        const gustUnitHtml = gustUnitLabel ? " " + belchertown_label_html(gustUnitLabel) : "";
        html += '<span class="forecast-wind-separator">|</span><span class="forecast-wind-gust">' + forecast_plain_number_text(row["windGust"]) + gustUnitHtml + '</span>';
    }
    html += '</div>';
    return html;
}

function forecast_is_three_hour_boundary(epoch) {
    const hour = parseInt(tzAdjustedMoment(epoch).format("H"), 10);
    return isFinite(hour) && hour % 3 === 0;
}

function forecast_current_period_slice(rows, periodHours, requireThreeHourBoundary) {
    if (!Array.isArray(rows) || rows.length === 0) return [];

    const nowEpoch = Date.now() / 1000;
    const periodNumber = parseFloat(periodHours);
    const periodSeconds = (isFinite(periodNumber) && periodNumber > 0 ? periodNumber : 1) * 3600;
    let firstFuture = -1;
    let foundTimestamp = false;
    let foundBoundaryTimestamp = !requireThreeHourBoundary;

    for (let i = 0; i < rows.length; i++) {
        const rowEpoch = forecast_number(rows[i] && rows[i]["time"]);
        if (rowEpoch === null) continue;

        foundTimestamp = true;
        if (requireThreeHourBoundary) {
            if (!forecast_is_three_hour_boundary(rowEpoch)) continue;
            foundBoundaryTimestamp = true;
        }

        if (rowEpoch <= nowEpoch && nowEpoch < rowEpoch + periodSeconds) {
            return rows.slice(i);
        }
        if (rowEpoch >= nowEpoch && firstFuture === -1) {
            firstFuture = i;
        }
    }

    if (firstFuture !== -1) {
        return rows.slice(firstFuture);
    }

    if (!foundBoundaryTimestamp) {
        return forecast_current_period_slice(rows, periodHours, false);
    }

    return foundTimestamp ? [] : rows.slice(0);
}

function forecast_pick_three_hourly_from_current_period(hourlyArray) {
    const rows = forecast_current_period_slice(hourlyArray, 3, true);
    const output = [];
    for (let i = 0; i < rows.length; i += 3) {
        output.push(rows[i]);
    }
    return output;
}

function forecast_render_hourly_tiles(hourlySource, maxTiles, tileClass, sourceData) {
    let html = "";
    const forecastInterval = (tileClass === "forecast-3hour") ? "forecast_3hr" : "forecast_1hr";
    const periodHours = forecastInterval === "forecast_3hr" ? 3 : 1;
    const displayRows = forecast_current_period_slice(hourlySource, periodHours, forecastInterval === "forecast_3hr");
    const tileCount = Math.min(maxTiles, displayRows.length);
    let lowTemp = null;
    let highTemp = null;

    if (forecastInterval === "forecast_1hr") {
        for (let rangeIndex = 0; rangeIndex < tileCount; rangeIndex++) {
            const rangeTempNum = forecast_number(displayRows[rangeIndex]["temperature"]);
            if (rangeTempNum !== null) {
                if (lowTemp === null || lowTemp > rangeTempNum) lowTemp = rangeTempNum;
                if (highTemp === null || highTemp < rangeTempNum) highTemp = rangeTempNum;
            }
        }
    }

    let rangeTemp = 2;
    let offset = 0;
    if (forecastInterval === "forecast_1hr" && lowTemp !== null && highTemp !== null) {
        rangeTemp = highTemp - lowTemp;
        if (rangeTemp < 2) {
            if (rangeTemp == 0) offset = 1;
            else if (rangeTemp == 1) offset = 0.67;
            rangeTemp = 2;
        }
    }

    for (let i = 0; i < tileCount; i++) {
        const row = displayRows[i] || {};
        const rowMoment = tzAdjustedMoment(row["time"]);
        const rawLabel = rowMoment.format(belchertown_label_text("$obs.label.time_forecast_time"));
        const previousTime = i === 0 ? Date.now() / 1000 : (displayRows[i - 1] || {})["time"];
        const showDay = !rowMoment.isSame(tzAdjustedMoment(previousTime), "day");
        const timeLabel = forecast_time(i, forecastInterval, rawLabel, showDay);
        const tempNum = forecast_number(row["temperature"]);
        const imageUrl = forecast_icon_url(row["icon"]);

        html += '<div class="forecast-day ' + tileClass + ' forecast-tile ' + (i === 0 ? 'forecast-today' : 'border-left') + '">';
        html += '<div class="forecast-card-label"><span id="weekday">' + timeLabel + '</span></div>';

        if (forecastInterval === "forecast_1hr") {
            const tempChartPadding = (tempNum !== null && highTemp !== null)
                ? parseInt((highTemp - tempNum + offset) * 76 / rangeTemp)
                : 0;
            html += '<div class="forecast-conditions forecast-conditions-1hour">';
            html += '<div class="forecast-temp-chart forecast-temp-chart-1hour">';
            html += '<div class="forecast-temp-chart-marker" style="top:' + tempChartPadding + 'px">';
            html += '<div class="forecast-image">';
            html += '<img class="forecast-icon" src="' + imageUrl + '" alt="" width="128" height="101" loading="lazy" decoding="async">';
            html += '</div>';
            html += '<span class="forecast-chart-temp">' + forecast_temp_text(row["temperature"]) + '</span>';
            html += '</div>';
            html += '</div>';
            html += '</div>';
        } else {
            html += '<div class="forecast-conditions">';
            html += '<img class="forecast-icon" src="' + imageUrl + '" alt="" width="128" height="101" loading="lazy" decoding="async"><br>';
            html += '<span class="forecast-condition-text">' + (row["summary"] || "") + '</span>';
            html += '</div>';
        }

        html += '<div class="forecast-card-bottom">';
        if (forecastInterval !== "forecast_1hr") {
            html += '<span class="forecast-high">' + forecast_temp_text(row["temperature"]) + '</span>';
            html += '<br>';
        }
        html += '<div class="forecast-precip">' + forecast_metric_rows(row) + '</div>';
        html += forecast_wind_html(row, forecastInterval !== "forecast_1hr", sourceData);
        html += forecast_daily_link(row["time"]);
        html += '</div>';
        html += '</div>';
    }

    return html;
}

function forecast_render_daily_tiles(dailySource, maxTiles, sourceData) {
    let html = "";
    const tileCount = Math.min(maxTiles, dailySource.length);

    for (let i = 0; i < tileCount; i++) {
        const row = dailySource[i] || {};
        const dayLabel = tzAdjustedMoment((row["time"] || 0) + 7200).format(belchertown_forecast_date_format("$obs.label.time_forecast_date"));
        const imageUrl = forecast_icon_url(row["icon"]);

        html += '<div class="forecast-day forecast-24hour forecast-tile ' + (i === 0 ? 'forecast-today' : 'border-left') + '">';
        html += '<div class="forecast-card-label"><span id="weekday">' + dayLabel + '</span></div>';
        html += '<div class="forecast-conditions">';
        html += '<img class="forecast-icon" src="' + imageUrl + '" alt="" width="128" height="101" loading="lazy" decoding="async">';
        html += '<br>';
        html += '<span class="forecast-condition-text">' + (row["summary"] || "") + '</span>';
        html += '</div>';
        html += '<div class="forecast-card-bottom">';
        html += '<span class="forecast-temp-range"><span class="forecast-high">' + forecast_temp_text(row["temperatureHigh"]) + '</span> | <span class="forecast-low">' + forecast_temp_text(row["temperatureLow"]) + '</span></span>';
        html += '<br>';
        html += '<div class="forecast-precip">' + forecast_metric_rows(row) + '</div>';
        html += forecast_wind_html(row, true, sourceData);
        html += forecast_daily_link(row["time"]);
        html += '</div>';
        html += '</div>';
    }

    return html;
}

function forecast_no_data_tile(tileClass) {
    return '<div class="forecast-day ' + tileClass + ' forecast-tile forecast-no-data">' +
        '<div class="forecast-conditions">' +
        '<span class="forecast-condition-text">' + forecast_escape_html(forecast_label_text("$obs.label.no_data")) + '</span>' +
        '</div>' +
        '</div>';
}

function forecast_replace_tiles(selector, html, fallbackTileClass) {
    const hasNewTiles = String(html || "").trim() !== "";

    document.querySelectorAll(selector).forEach(function(el) {
        if (hasNewTiles) {
            el.innerHTML = html;
            return;
        }

        if (el.children.length > 0) {
            belchertown_debug("Forecast: keeping existing " + selector + " tiles because refresh produced no rows.");
            return;
        }

        el.innerHTML = forecast_no_data_tile(fallbackTileClass);
    });
}

function forecast_fit_daily_condition_text() {
    const minFontSize = 11;

    document.querySelectorAll(".day_forecasts .forecast-day.forecast-tile").forEach(function(tile) {
        const conditions = tile.querySelector(".forecast-conditions");
        const text = tile.querySelector(".forecast-condition-text");
        if (!conditions || !text || conditions.offsetParent === null) {
            return;
        }

        tile.style.removeProperty("--forecast-condition-band-height");
        text.style.removeProperty("font-size");
        text.style.removeProperty("line-height");

        let fontSize = parseFloat(window.getComputedStyle(text).fontSize) || 14;
        while (fontSize > minFontSize && conditions.scrollHeight > conditions.clientHeight + 1) {
            fontSize -= 1;
            text.style.fontSize = fontSize + "px";
            text.style.lineHeight = "1.08";
        }

        if (conditions.scrollHeight > conditions.clientHeight + 1) {
            tile.style.setProperty("--forecast-condition-band-height", Math.ceil(conditions.scrollHeight) + "px");
        }
    });
}

function forecast_update_aqi(data) {
    try {
        const aqiPayload = data["aqi"] && data["aqi"][0] ? data["aqi"][0] : null;
        if (data["aqi"] && data["aqi"][0] && data["aqi"][0]["success"] && !data["aqi"][0]["error"]) {
            const aqiPeriod = data["aqi"][0]["response"][0]["periods"][0];
            const aqiValue = aqiPeriod["aqi"];
            const aqiCategory = forecast_aqi_translate(aqiPeriod["category"]);
            document.querySelectorAll(".wx-aqi").forEach(function(el) {
                el.textContent = aqiValue;
            });
            document.querySelectorAll(".wx-aqi-category").forEach(function(el) {
                el.textContent = aqiCategory;
            });
            if ("$Extras.aqi_location_enabled" === "1") {
                const aqiPlace = data["aqi"][0]["response"][0]["place"]["name"] || "";
                document.querySelectorAll(".aqi_location_outer").forEach(function(el) {
                    el.innerHTML = aqiPlace ? "<br>" + aqiPlace : "";
                    el.style.textTransform = "capitalize";
                });
            }
            try {
                document.querySelectorAll(".station-observations .aqi").forEach(function(el) {
                    el.textContent = aqiValue + " ";
                    const category = document.createElement("span");
                    category.className = "wx-aqi-category";
                    category.textContent = aqiCategory;
                    el.appendChild(category);
                });
            } catch (err) {
                // AQI not in the station observation table, so silently exit
            }
            get_aqi_color(aqiValue);
            forecast_register_external_observations("aqi", data, {
                sourceProvider: aqiPayload["provider"],
                epoch: aqiPeriod["timestamp"] || data["generated_at"] || data["timestamp"]
            });
        } else if (data["aqi"] && data["aqi"][0] && data["aqi"][0]["success"] && data["aqi"][0]["error"] && data["aqi"][0]["error"]["code"] === "warn_no_data") {
            const aqiNoDataCategory = forecast_aqi_translate("");
            document.querySelectorAll(".wx-aqi").forEach(function(el) {
                el.textContent = forecast_label_text("$obs.label.no_data");
            });
            document.querySelectorAll(".wx-aqi-category").forEach(function(el) {
                el.textContent = aqiNoDataCategory;
            });
            clear_aqi_color();
            if ("$Extras.aqi_location_enabled" === "1") {
                document.querySelectorAll(".aqi_location_outer").forEach(function(el) {
                    el.innerHTML = "";
                });
            }
            try {
                document.querySelectorAll(".station-observations .aqi").forEach(function(el) {
                    el.textContent = forecast_label_text("$obs.label.no_data") + " ";
                    const category = document.createElement("span");
                    category.className = "wx-aqi-category";
                    category.textContent = aqiNoDataCategory;
                    el.appendChild(category);
                });
            } catch (err) {
                // AQI not in the station observation table, so silently exit
            }
            forecast_register_external_observations("aqi", data, {
                sourceProvider: aqiPayload["provider"],
                epoch: data["generated_at"] || data["timestamp"]
            });
        }
    } catch (err) {
        belchertown_debug("Forecast: AQI data missing or malformed, skipping: " + err);
    }
}

function forecast_has_common_schema(data) {
    return data && Array.isArray(data["hourly"]) && Array.isArray(data["daily"]);
}

// ── Unit Switcher: convert forecast rows from their fixed fetch-time system
// (resolved via BU_resolveForecastBase, reading the payload's own "units"
// field - see new-belchertown.js.tmpl) to METRICWX in place, once, before
// any rendering/min-max/padding logic runs on them. Idempotent - rows
// already converted in this session are skipped via a marker flag.
function BU_convertForecastRow(row, baseKey) {
    // Without the visible unit switcher, forecast_units is already the display contract.
    if (!window.BU_UNIT_SWITCHER_ENABLED) { return; }
    if (!row || row.__BU_converted) { return; }
    if (typeof BU_forecastToMetricWX !== "function") { return; }

    if (row.temperature !== undefined && row.temperature !== null) {
        row.temperature = BU_forecastToMetricWX("temp", row.temperature, baseKey);
    }
    if (row.temperatureHigh !== undefined && row.temperatureHigh !== null) {
        row.temperatureHigh = BU_forecastToMetricWX("temp", row.temperatureHigh, baseKey);
    }
    if (row.temperatureLow !== undefined && row.temperatureLow !== null) {
        row.temperatureLow = BU_forecastToMetricWX("temp", row.temperatureLow, baseKey);
    }
    if (row.dewPoint !== undefined && row.dewPoint !== null) {
        row.dewPoint = BU_forecastToMetricWX("temp", row.dewPoint, baseKey);
    }
    if (row.windSpeed !== undefined && row.windSpeed !== null) {
        row.windSpeed = BU_forecastToMetricWX("speed", row.windSpeed, baseKey);
    }
    if (row.windGust !== undefined && row.windGust !== null) {
        row.windGust = BU_forecastToMetricWX("speed", row.windGust, baseKey);
    }
    if (row.snowDepth !== undefined && row.snowDepth !== null) {
        row.snowDepth = BU_forecastToMetricWX("precip", row.snowDepth, baseKey);
    }
    if (row.visibility !== undefined && row.visibility !== null) {
        row.visibility = BU_forecastToMetricWX("vis", row.visibility, baseKey);
    }

    // Re-render each value into the user's chosen display system using the
    // same BU_SYS converters current conditions already use.
    var sysKey = (typeof BU_getSystem === "function") ? BU_getSystem() : "metric";
    var s = (typeof BU_SYS !== "undefined") ? BU_SYS[sysKey] : null;
    if (s) {
        if (row.temperature !== undefined && row.temperature !== null) { row.temperature = s.temp(row.temperature); }
        if (row.temperatureHigh !== undefined && row.temperatureHigh !== null) { row.temperatureHigh = s.temp(row.temperatureHigh); }
        if (row.temperatureLow !== undefined && row.temperatureLow !== null) { row.temperatureLow = s.temp(row.temperatureLow); }
        if (row.dewPoint !== undefined && row.dewPoint !== null) { row.dewPoint = s.temp(row.dewPoint); }
        if (row.windSpeed !== undefined && row.windSpeed !== null) { row.windSpeed = s.speed(row.windSpeed); }
        if (row.windGust !== undefined && row.windGust !== null) { row.windGust = s.speed(row.windGust); }
        if (row.snowDepth !== undefined && row.snowDepth !== null) { row.snowDepth = s.rain(row.snowDepth); row.snowUnit = s.rl; }
        if (row.visibility !== undefined && row.visibility !== null) { row.visibility = s.distance(row.visibility); row.visibilityUnit = s.dl; }
    }

    row.__BU_converted = true;
}

function BU_convertForecastRows(rows, baseKey) {
    if (!Array.isArray(rows)) { return; }
    for (var i = 0; i < rows.length; i++) { BU_convertForecastRow(rows[i], baseKey); }
}

function forecast_render_common(data) {
    forecast_update_aqi(data);

    // ── Unit Switcher: keep a pristine, unconverted copy so switching units
    // later can re-derive from the original fetched values rather than
    // re-converting already-converted (and now stale) numbers.
    try {
        window.BU_lastForecastRaw = JSON.parse(JSON.stringify(data));
    } catch (_BU_e) { /* silent */ }

    var baseKey = (typeof BU_resolveForecastBase === "function") ? BU_resolveForecastBase(data) : "uk2";
    belchertown_debug("Unit Switcher: forecast base unit resolved as '" + baseKey + "' (from payload units='" + data.units + "')");

    const hourly = Array.isArray(data["hourly"]) ? data["hourly"] : [];
    const threeHourly = Array.isArray(data["threeHourly"]) ? data["threeHourly"] : forecast_pick_three_hourly_from_current_period(hourly);
    const daily = Array.isArray(data["daily"]) ? data["daily"] : [];

    BU_convertForecastRows(hourly, baseKey);
    BU_convertForecastRows(threeHourly, baseKey);
    BU_convertForecastRows(daily, baseKey);

    const lastUpdated = data["generated_at"] || data["timestamp"] || (Date.now() / 1000);
    forecast_last_updated_epoch = forecast_number(lastUpdated);

    forecast_render_source(data);
    forecast_register_external_observations("forecast", data, {epoch: lastUpdated});
    const onehrHtml = forecast_render_hourly_tiles(hourly, 16, "forecast-1hour", data);
    const threehrHtml = forecast_render_hourly_tiles(threeHourly, 8, "forecast-3hour", data);
    const dailyHtml = forecast_render_daily_tiles(daily, 7, data);
    forecast_replace_tiles(".onehr_forecasts", onehrHtml, "forecast-1hour");
    forecast_replace_tiles(".threehr_forecasts", threehrHtml, "forecast-3hour");
    forecast_replace_tiles(".day_forecasts", dailyHtml, "forecast-24hour");
    forecast_render_relative_timestamps();
    forecast_start_relative_timer();
    if (typeof forecast_sync_row_height === "function") {
        forecast_sync_row_height();
    }
    show_forcast_alert(data);
}

function update_forecast_data(data) {
    forecast_provider = "$Extras.forecast_provider";
    belchertown_debug("Forecast: Provider is " + forecast_provider);
    belchertown_debug("Forecast: Updating data");
    belchertown_debug(data);

    if (forecast_provider == "N/A") {
        document.querySelectorAll(".forecastrow").forEach(function(el) {
            el.style.display = "none";
        });
        belchertown_debug("Forecast: No provider, hiding forecastrow");
        return;
    } else if (forecast_has_common_schema(data)) {
        forecast_render_common(data);
        return;
    } else {
        belchertown_debug("Forecast: Missing normalized forecast schema");
    }
}

// ── Unit Switcher: re-render the forecast tiles in the newly chosen system,
// using the pristine unconverted snapshot taken at the last successful fetch.
// Called from BU_reapplyAll() in new-belchertown.js.tmpl.
window.BU_reapplyForecast = function() {
    if (typeof current_conditions_data !== "undefined" && current_conditions_data) {
        const fallbackForecastData = window.BU_lastForecastRaw || (typeof forecast_data !== "undefined" ? forecast_data : {});
        update_current_conditions(current_conditions_data, fallbackForecastData);
    }
    if (!window.BU_lastForecastRaw) {
        belchertown_debug("Unit Switcher: no forecast data fetched yet, nothing to re-render.");
        return;
    }
    if (typeof forecast_has_common_schema === "function" && forecast_has_common_schema(window.BU_lastForecastRaw)) {
        forecast_render_common(window.BU_lastForecastRaw);
    }
};

