function get_outTemp_color(unit, outTemp, returnColor = false) {
    if (outTemp != null) {
        outTemp = parseFloat(outTemp).toFixed(0); // Convert back to decimal literal
    } else {
        return // No temperature value provided
    }

    if (unit == "degree_F") {
        var outTemp_color = new_gradient_temp(outTemp, 10, 120);
    } else if (unit == "degree_C") {
        var outTemp_color = new_gradient_temp(outTemp, -12, 49);
    } else {
        return // No unit provided
    }

    // Return the color value if requested, otherwise just set the div color
    if (returnColor) {
        return outTemp_color;
    } else {
        belchertown_apply_readable_color(".outtemp_outer", outTemp_color);
    }
}

function kts_to_beaufort(windspeed) {
    // Match weewx.wxformulas.beaufort(): given windspeed in knots,
    // return the Beaufort scale number.
    var ws = parseFloat(windspeed);
    if (!isFinite(ws)) {
        return null;
    }
    ws = Math.abs(ws);

    if (ws < 1) {
        return 0
    } else if (ws < 4) {
        return 1
    } else if (ws < 7) {
        return 2
    } else if (ws < 11) {
        return 3
    } else if (ws < 17) {
        return 4
    } else if (ws < 22) {
        return 5
    } else if (ws < 28) {
        return 6
    } else if (ws < 34) {
        return 7
    } else if (ws < 41) {
        return 8
    } else if (ws < 48) {
        return 9
    } else if (ws < 56) {
        return 10
    } else if (ws < 64) {
        return 11
    } else {
        return 12
    }
}

function beaufort_cat(beaufort) {
    // Given Beaufort number, returns category description
    switch (beaufort) {
        case 0:
            return "$beaufort0"
        case 1:
            return "$beaufort1"
        case 2:
            return "$beaufort2"
        case 3:
            return "$beaufort3"
        case 4:
            return "$beaufort4"
        case 5:
            return "$beaufort5"
        case 6:
            return "$beaufort6"
        case 7:
            return "$beaufort7"
        case 8:
            return "$beaufort8"
        case 9:
            return "$beaufort9"
        case 10:
            return "$beaufort10"
        case 11:
            return "$beaufort11"
        case 12:
            return "$beaufort12"
        default:
            return "--"
    }
}

function beaufort_to_knots(beaufort) {
    var b = parseInt(beaufort, 10);
    if (!isFinite(b) || b < 0) {
        return null;
    }
    // Midpoint-style representative knot values by Beaufort number.
    var scale = [0, 2, 5, 8, 13, 19, 24, 30, 37, 44, 52, 60, 68];
    return scale[Math.min(b, 12)];
}

