function formatAlmanacEpochTime(epoch, formatString, unavailableText) {
    var timestamp = parseFloat(epoch);
    var adjusted;

    if (!isFinite(timestamp)) {
        return unavailableText;
    }

    adjusted = tzAdjustedMoment(timestamp);
    if (adjusted && typeof adjusted.isValid === "function" && adjusted.isValid()) {
        return adjusted.format(formatString);
    }

    return unavailableText;
}

function enhanceAlmanacExtrasModal(almanacData) {
    var modalBody = document.querySelector("#almanac-modal .almanac-extras-modal-body");
    var sourceRaw;
    var sourceLabel;
    var sourceNote;
    var sourceNoteSmall;
    var detailsContainer;
    var daylightValue;
    var sunriseEpoch;
    var sunsetEpoch;
    var totalDaylightLabel = belchertown_decode_html_entities("$obs.label.total_daylight").toLowerCase();
    var phaseLabel = belchertown_decode_html_entities("$obs.label.phase").toLowerCase();
    var moonAgeValue = "";
    var moonAgeLabel = belchertown_decode_html_entities("$obs.label.moon_age");
    var dataSourceLabel = belchertown_decode_html_entities("$obs.label.data_source");
    var sourceNoneLabel = belchertown_decode_html_entities("$obs.label.source_none");
    var hourShort = belchertown_decode_html_entities("$obs.label.hour_short");
    var minuteShort = belchertown_decode_html_entities("$obs.label.minute_short");
    var secondShort = belchertown_decode_html_entities("$obs.label.second_short");
    var almanacDateTimeFormat = belchertown_label_text("$obs.label.time_records_page_full_date");
    var almanacTimeFormat = belchertown_label_text("$obs.label.time_sunrise");

    if (!moonAgeLabel || moonAgeLabel === "moon_age") {
        moonAgeLabel = "Moon age";
    }
    if (!dataSourceLabel || dataSourceLabel === "data_source") {
        dataSourceLabel = "Data source";
    }
    if (!sourceNoneLabel || sourceNoneLabel === "source_none") {
        sourceNoneLabel = "None";
    }
    if (!hourShort || hourShort === "hour_short") {
        hourShort = "h";
    }
    if (!minuteShort || minuteShort === "minute_short") {
        minuteShort = "m";
    }
    if (!secondShort || secondShort === "second_short") {
        secondShort = "s";
    }
    if (!almanacDateTimeFormat || almanacDateTimeFormat === "time_records_page_full_date") {
        almanacDateTimeFormat = "L LTS";
    }
    if (!almanacTimeFormat || almanacTimeFormat === "time_sunrise") {
        almanacTimeFormat = "LT";
    }

    if (!modalBody) {
        return;
    }

    belchertown_decode_text_nodes(modalBody);

    var rowCells = function(row, tagName) {
        return Array.prototype.filter.call(row.children, function(cell) {
            return cell.tagName === tagName;
        });
    };

    modalBody.querySelectorAll("table.celestial").forEach(function(table) {

        table.querySelectorAll("tr").forEach(function(row) {
            var headerCells = rowCells(row, "TH");
            var cells = rowCells(row, "TD");

            row.classList.remove("celestial-row", "celestial-row--header", "celestial-row--item");

            if (headerCells.length) {
                row.classList.add("celestial-row", "celestial-row--header");
                return;
            }

            if (cells.length < 2) {
                return;
            }

            cells.forEach(function(cell) {
                cell.classList.remove("celestial-cell-label", "celestial-cell-value");
            });

            var labelCell = cells[0];
            var valueCell = cells[1];
            var labelText = labelCell.textContent.replace(/\u00a0/g, " ").trim();
            var valueText = valueCell.textContent.replace(/\u00a0/g, " ").trim();

            // Remove spacer rows coming from legacy table formatting.
            if (!labelText && !valueText) {
                row.remove();
                return;
            }

            row.classList.add("celestial-row", "celestial-row--item");
            labelCell.classList.add("celestial-cell-label");
            valueCell.classList.add("celestial-cell-value");

            // Localize date/time-like values independent of UI language.
            var looksLikeDateTime = /\d{1,4}[\/\-]\d{1,2}[\/\-]\d{1,4}/.test(valueText) && /\d{1,2}:\d{2}/.test(valueText);
            var looksLikeTimeOnly = !looksLikeDateTime && /\b\d{1,2}:\d{2}(:\d{2})?\b/.test(valueText);
            if (looksLikeDateTime && valueText && valueText !== "--") {
                var parsed = belchertown_parse_date_time(
                    valueText,
                    belchertown_date_time_parse_formats()
                );
                if (parsed.isValid()) {
                    var formattedDateTime = parsed.locale(dayjs.locale()).format(almanacDateTimeFormat);
                    formattedDateTime = formattedDateTime.replace(/\s([AP]M)$/i, "\u00a0$1");
                    valueCell.textContent = formattedDateTime;
                } else {
                    valueCell.textContent = valueText.replace(/\s([AP]M)$/i, "\u00a0$1");
                }
            } else if (looksLikeTimeOnly && valueText && valueText !== "--") {
                var parsedTime = dayjs(
                    valueText,
                    [
                        "HH:mm:ss",
                        "H:mm:ss",
                        "HH:mm",
                        "H:mm",
                        "hh:mm:ss A",
                        "h:mm:ss A",
                        "hh:mm A",
                        "h:mm A"
                    ],
                    true
                );
                if (parsedTime.isValid()) {
                    var formattedTime = parsedTime.locale(dayjs.locale()).format(almanacTimeFormat);
                    formattedTime = formattedTime.replace(/\s([AP]M)$/i, "\u00a0$1");
                    valueCell.textContent = formattedTime;
                } else {
                    valueCell.textContent = valueText.replace(/\s([AP]M)$/i, "\u00a0$1");
                }
            }
        });
    });

    if (almanacData && almanacData["moon"]) {
        moonAgeValue = belchertown_decode_html_entities(almanacData["moon"]["moon_age"]).replace(/\u00a0/g, " ").trim();
    }
    if (!moonAgeValue && weewx_data && weewx_data["almanac"] && weewx_data["almanac"]["moon"]) {
        moonAgeValue = belchertown_decode_html_entities(weewx_data["almanac"]["moon"]["moon_age"]).replace(/\u00a0/g, " ").trim();
    }
    if (moonAgeValue && moonAgeValue !== "--") {
        var moonTable = modalBody.querySelectorAll("table.celestial")[1];
        if (moonTable) {
            var moonAgeRow = moonTable.querySelector("tr[data-row='moon-age']");
            if (!moonAgeRow) {
                moonAgeRow = document.createElement("tr");
                moonAgeRow.className = "celestial-row celestial-row--item";
                moonAgeRow.setAttribute("data-row", "moon-age");
                moonAgeRow.innerHTML = "<td class='label celestial-cell-label'></td><td class='data celestial-cell-value'></td>";
                moonAgeRow.children[0].textContent = moonAgeLabel;

                var phaseRow = null;
                var moonRows = moonTable.querySelectorAll("tr");
                for (var ri = 0; ri < moonRows.length; ri++) {
                    var tds = rowCells(moonRows[ri], "TD");
                    if (tds.length >= 2) {
                        var lbl = tds[0].textContent.replace(/\u00a0/g, " ").trim().toLowerCase();
                        if (lbl === phaseLabel || lbl.indexOf(phaseLabel) !== -1) {
                            phaseRow = moonRows[ri];
                            break;
                        }
                    }
                }

                if (phaseRow) {
                    phaseRow.parentNode.insertBefore(moonAgeRow, phaseRow);
                } else {
                    (moonTable.tBodies[0] || moonTable).appendChild(moonAgeRow);
                }
            }

            var moonAgeCells = moonAgeRow.querySelectorAll("td");
            if (moonAgeCells.length > 1) {
                moonAgeCells[1].textContent = moonAgeValue;
            }
        }
    }

    sourceRaw = ((almanacData && almanacData["source"]) || "").toString().toLowerCase();
    if (!sourceRaw && weewx_data && weewx_data["almanac"]) {
        sourceRaw = String(weewx_data["almanac"]["source"] || "").toLowerCase();
    }
    if (!sourceRaw) {
        sourceRaw = "none";
    }
    if (sourceRaw === "none") {
        // Promote to PyEphem when usable almanac signals exist.
        var hasDiagramSignal = false;
        if (almanacData && almanacData["diagram"]) {
            var sunD = almanacData["diagram"]["sun"] || {};
            var moonD = almanacData["diagram"]["moon"] || {};
            hasDiagramSignal = !!(
                (sunD["path_d"] && String(sunD["path_d"]).trim().length > 0) ||
                (moonD["path_d"] && String(moonD["path_d"]).trim().length > 0) ||
                (sunD["track_points"] && String(sunD["track_points"]).trim().length > 0) ||
                (moonD["track_points"] && String(moonD["track_points"]).trim().length > 0) ||
                isFinite(parseFloat(sunD["azimuth"])) ||
                isFinite(parseFloat(moonD["azimuth"]))
            );
        }
        var hasSunTimesSignal = false;
        if (almanacData) {
            hasSunTimesSignal = !!(
                almanacData["sunrise_epoch"] ||
                almanacData["sunset_epoch"] ||
                (typeof almanacData["sunrise"] === "string" && almanacData["sunrise"].trim() !== "") ||
                (typeof almanacData["sunset"] === "string" && almanacData["sunset"].trim() !== "")
            );
        }
        if (hasDiagramSignal || hasSunTimesSignal) {
            sourceRaw = "pyephem";
        }
    }
    if (sourceRaw === "skyfield") {
        sourceLabel = "Skyfield";
    } else if (sourceRaw === "pyephem") {
        sourceLabel = "PyEphem";
    } else {
        sourceLabel = sourceNoneLabel;
    }

    sourceNote = modalBody.querySelector(".celestial_source_note");
    if (!sourceNote) {
        sourceNote = document.createElement("div");
        sourceNote.className = "celestial_source_note";
        sourceNote.appendChild(document.createElement("small"));
    }

    sourceNoteSmall = sourceNote.querySelector("small");
    if (!sourceNoteSmall) {
        sourceNoteSmall = document.createElement("small");
        sourceNote.innerHTML = "";
        sourceNote.appendChild(sourceNoteSmall);
    }
    sourceNoteSmall.innerHTML = (
        belchertown_escape_html(dataSourceLabel) +
        ": <strong>" +
        belchertown_escape_html(sourceLabel) +
        "</strong>"
    );

    detailsContainer = modalBody.querySelector("#celestial_details");
    if (detailsContainer) {
        detailsContainer.appendChild(sourceNote);
    } else {
        modalBody.appendChild(sourceNote);
    }

    // If total daylight remained '--', compute a local fallback from sunrise/sunset.
    daylightValue = null;
    modalBody.querySelectorAll("table.celestial tr").forEach(function(row) {
        var tds = rowCells(row, "TD");
        if (tds.length >= 2) {
            var lbl = tds[0].textContent.replace(/\u00a0/g, " ").trim().toLowerCase();
            if (lbl === totalDaylightLabel || lbl.indexOf(totalDaylightLabel) !== -1) {
                daylightValue = tds[1];
            }
        }
    });
    if (daylightValue && daylightValue.textContent.replace(/\u00a0/g, " ").trim() === "--") {
        sunriseEpoch = parseFloat(almanacData && almanacData["sunrise_epoch"]);
        sunsetEpoch = parseFloat(almanacData && almanacData["sunset_epoch"]);
        if (isFinite(sunriseEpoch) && isFinite(sunsetEpoch) && sunsetEpoch >= sunriseEpoch) {
            var total = Math.round(sunsetEpoch - sunriseEpoch);
            var hours = Math.floor(total / 3600);
            var mins = Math.floor((total % 3600) / 60);
            var secs = total % 60;
            daylightValue.textContent = hours + hourShort + " " + mins + minuteShort + " " + secs + secondShort;
        }
    }
}

function getNestedValue(obj, path, fallback = "N/A") {
    try {
        var cur = obj;
        for (var i = 0; i < path.length; i++) {
            if (cur == null || typeof cur !== "object" || !(path[i] in cur)) {
                return fallback;
            }
            cur = cur[path[i]];
        }
        return (cur === null || cur === undefined || cur === "") ? fallback : cur;
    } catch (e) {
        return fallback;
    }
}

function formatSnapshotMetricValue(value) {
    if (value === null || value === undefined || value === "") {
        return "N/A";
    }
    return String(value).replace(/\//g, "&NoBreak;/&NoBreak;");
}

function updateDailySnapshot(data, key) {
    var d = data[key];
    if (!d) return;
    belchertown_set_html(".dailystatshigh", formatSnapshotMetricValue(getNestedValue(d, ["outTemp", "max"])));
    belchertown_set_html(".dailystatslow", formatSnapshotMetricValue(getNestedValue(d, ["outTemp", "min"])));
    belchertown_set_html(".dailystatswindavg", formatSnapshotMetricValue(getNestedValue(d, ["wind", "average"])));
    belchertown_set_html(".dailystatswindmax", formatSnapshotMetricValue(getNestedValue(d, ["wind", "max"])));
    belchertown_set_html(".dailystatsrain", formatSnapshotMetricValue(getNestedValue(d, ["rain", "sum"])));
    belchertown_set_html(".dailystatsrainrate", formatSnapshotMetricValue(getNestedValue(d, ["rain", "max"])));
    belchertown_set_html(".dailystatsuvavg", formatSnapshotMetricValue(getNestedValue(d, ["uv", "average"])));
    belchertown_set_html(".dailystatsuvmax", formatSnapshotMetricValue(getNestedValue(d, ["uv", "max"])));
    belchertown_set_html(".dailystatsradiationavg", formatSnapshotMetricValue(getNestedValue(d, ["solar_radiation", "average"])));
    belchertown_set_html(".dailystatsradiationmax", formatSnapshotMetricValue(getNestedValue(d, ["solar_radiation", "max"])));
    belchertown_set_html(".dailystatssunshineDur", formatSnapshotMetricValue(getNestedValue(d, ["sunshineDur", "sum"])));
    if (d["wind"] && d["wind"]["windrun"]) {
        belchertown_set_html(".dailywindrun", formatSnapshotMetricValue(d["wind"]["windrun"]));
    }
    if (typeof BU_applyDailySnapshot === "function") {
        BU_applyDailySnapshot(data, key); // Unit Switcher: overwrite with chosen-unit values
    }
}

function updateMonthlySnapshot(data, key) {
    var d = data[key];
    if (!d) return;
    belchertown_set_html(".monthstatshigh", formatSnapshotMetricValue(getNestedValue(d, ["outTemp", "max"])));
    belchertown_set_html(".monthstatslow", formatSnapshotMetricValue(getNestedValue(d, ["outTemp", "min"])));
    belchertown_set_html(".monthstatswindavg", formatSnapshotMetricValue(getNestedValue(d, ["wind", "average"])));
    belchertown_set_html(".monthstatswindmax", formatSnapshotMetricValue(getNestedValue(d, ["wind", "max"])));
    belchertown_set_html(".monthstatsrain", formatSnapshotMetricValue(getNestedValue(d, ["rain", "sum"])));
    belchertown_set_html(".monthstatsrainrate", formatSnapshotMetricValue(getNestedValue(d, ["rain", "max"])));
    belchertown_set_html(".monthstatsuvavg", formatSnapshotMetricValue(getNestedValue(d, ["uv", "average"])));
    belchertown_set_html(".monthstatsuvmax", formatSnapshotMetricValue(getNestedValue(d, ["uv", "max"])));
    belchertown_set_html(".monthstatsradiationavg", formatSnapshotMetricValue(getNestedValue(d, ["solar_radiation", "average"])));
    belchertown_set_html(".monthstatsradiationmax", formatSnapshotMetricValue(getNestedValue(d, ["solar_radiation", "max"])));
    belchertown_set_html(".monthstatssunshineDur", formatSnapshotMetricValue(getNestedValue(d, ["sunshineDur", "sum"])));
    if (typeof BU_applyMonthlySnapshot === "function") {
        BU_applyMonthlySnapshot(data, key); // Unit Switcher: overwrite with chosen-unit values
    }
}

document.addEventListener("change", function(event) {
    var daySelect = event.target.closest("#snapshot-day-select");
    if (daySelect && weewx_data) {
        updateDailySnapshot(weewx_data, daySelect.value);
        return;
    }
    var monthSelect = event.target.closest("#snapshot-month-select");
    if (monthSelect && weewx_data) {
        updateMonthlySnapshot(weewx_data, monthSelect.value);
    }
});


// ============================================================================
// Belchertown Unit Switcher
// Base units are METRICWX (°C, m/s, hPa, mm) as published in weewx_data.json
// *_raw fields and the MQTT payload's _C / _mps / _mbar / _mm suffixed keys.
// Converts to the user's chosen display system and writes into the existing
// DOM elements that update_weewx_data() / updateDailySnapshot() /
// updateMonthlySnapshot() / MQTT handlers already populate.
// ============================================================================
#set $unitSwitcherJsEnabled = False
#if $Extras.has_key('unit_switching') and str($Extras.unit_switching).strip() == "1"
#set $unitSwitcherJsEnabled = True
#end if

// ── Forecast data is fetched server-side already converted into ONE fixed
// system (us / si / ca / uk2), mirroring new_belchertown.py's
// _normalize_forecast_units(). It is never re-fetched client-side, so we
// read which of the four it is DIRECTLY from forecast.json's own "units"
// field (every provider build function in new_belchertown.py stamps
// "units": forecast_units into the payload - this is ground truth, not
// an inference) and convert FROM that fixed system TO whichever display
// system the user has chosen.
//
//   forecast_units | temp        | wind speed       | precip | visibility | pressure
//   us             | fahrenheit  | mile_per_hour    | inch   | miles      | hPa (always)
//   si             | celsius     | meter_per_second | mm     | km         | hPa (always)
//   ca             | celsius     | km_per_hour      | mm     | km         | hPa (always)
//   uk2            | celsius     | mile_per_hour    | mm     | miles      | hPa (always)
function BU_resolveForecastBase(forecastData) {
    var aliasMap = { imperial: "us", metric: "ca", metricwx: "si" };
    var valid = ["us", "si", "ca", "uk2"];

    // 1. Ground truth: the fetched payload's own "units" field.
    if (forecastData && forecastData.units) {
        var fromPayload = String(forecastData.units).trim().toLowerCase();
        fromPayload = aliasMap[fromPayload] || fromPayload;
        if (valid.indexOf(fromPayload) !== -1) {
            return fromPayload;
        }
    }

    // 2. Explicit site config, if set.
    // #if $Extras.has_key('forecast_units') and $Extras.forecast_units.strip() != "" and $Extras.forecast_units.strip().lower() != "auto"
    var explicit = "#echo $Extras.forecast_units.strip().lower() #";
    explicit = aliasMap[explicit] || explicit;
    if (valid.indexOf(explicit) !== -1) {
        return explicit;
    }
    // #end if

    // 3. Last resort: infer from the site's configured display unit labels.
    var tempLabel = "$unit.label.outTemp";
    var speedLabel = "$unit.label.windSpeed";
    if (tempLabel.indexOf("F") !== -1) { return "us"; }
    if (speedLabel.indexOf("km") !== -1) { return "ca"; }
    if (speedLabel.indexOf("m/s") !== -1 || speedLabel.indexOf("mps") !== -1) { return "si"; }
    return "uk2";
}

var BU_FORECAST_FROM = {
    us:  { temp: function(f) { return (f - 32) * 5 / 9; },      speed: function(mph) { return mph / 2.23694; },  precip: function(inch) { return inch * 25.4; },  vis: function(mi) { return mi * 1.609344; } },
    si:  { temp: function(c) { return c; },                      speed: function(ms)  { return ms; },             precip: function(mm)   { return mm; },           vis: function(km) { return km; } },
    ca:  { temp: function(c) { return c; },                      speed: function(kmh) { return kmh / 3.6; },      precip: function(mm)   { return mm; },           vis: function(km) { return km; } },
    uk2: { temp: function(c) { return c; },                      speed: function(mph) { return mph / 2.23694; },  precip: function(mm)   { return mm; },           vis: function(mi) { return mi * 1.609344; } },
};

// Convert a forecast value (already in baseKey's units) to METRICWX
// (°C, m/s, mm, km) so it can be fed through the same BU_SYS converters used
// for current conditions.
function BU_forecastToMetricWX(kind, value, baseKey) {
    var v = parseFloat(value);
    if (isNaN(v)) { return null; }
    var conv = BU_FORECAST_FROM[baseKey];
    if (!conv || !conv[kind]) { return null; }
    return conv[kind](v);
}

var BU_SYS = {
    us:          { temp:function(c){return c*9/5+32;},   tl:"\u00b0F", speed:function(ms){return ms*2.23694;}, sl:"mph",  press:function(h){return h*0.02953;}, pl:"inHg", rain:function(mm){return mm*0.03937;}, rl:"in",  rrl:"in/h", distance:function(km){return km*0.621371;}, dl:"mi", altitude:function(m){return m*3.28084;}, al:"ft" },
    uk:          { temp:function(c){return c;},           tl:"\u00b0C", speed:function(ms){return ms*2.23694;}, sl:"mph",  press:function(h){return h;},          pl:"hPa",  rain:function(mm){return mm;},         rl:"mm",  rrl:"mm/h", distance:function(km){return km*0.621371;}, dl:"mi", altitude:function(m){return m;},         al:"m" },
    metric:      { temp:function(c){return c;},           tl:"\u00b0C", speed:function(ms){return ms*3.6;},     sl:"km/h", press:function(h){return h;},          pl:"hPa",  rain:function(mm){return mm;},         rl:"mm",  rrl:"mm/h", distance:function(km){return km;},          dl:"km", altitude:function(m){return m;},         al:"m" },
    scandinavia: { temp:function(c){return c;},           tl:"\u00b0C", speed:function(ms){return ms;},         sl:"m/s",  press:function(h){return h;},          pl:"hPa",  rain:function(mm){return mm;},         rl:"mm",  rrl:"mm/h", distance:function(km){return km;},          dl:"km", altitude:function(m){return m;},         al:"m" },
    canada:      { temp:function(c){return c;},           tl:"\u00b0C", speed:function(ms){return ms*3.6;},     sl:"km/h", press:function(h){return h*0.1;},      pl:"kPa",  rain:function(mm){return mm;},         rl:"mm",  rrl:"mm/h", distance:function(km){return km;},          dl:"km", altitude:function(m){return m;},         al:"m" },
    nautical:    { temp:function(c){return c;},           tl:"\u00b0C", speed:function(ms){return ms*1.94384;}, sl:"kt",   press:function(h){return h;},          pl:"hPa",  rain:function(mm){return mm;},         rl:"mm",  rrl:"mm/h", distance:function(km){return km*0.539957;}, dl:"nm", altitude:function(m){return m;},         al:"m" },
};

var BU_CONFIGURED_UNIT_NAMES = $configured_unit_names_by_kind_json;
var BU_CONFIGURED_UNIT_LABELS = $configured_unit_labels_by_kind_json;

// BEGIN MQTT CONFIGURED UNIT CONVERSION
var BU_METRICWX_TO_CONFIGURED_UNIT = {
    degree_c:          { kind: "temp",     convert: function(c) { return c; } },
    degree_f:          { kind: "temp",     convert: function(c) { return c * 9 / 5 + 32; } },
    meter_per_second:  { kind: "speed",    convert: function(ms) { return ms; } },
    km_per_hour:       { kind: "speed",    convert: function(ms) { return ms * 3.6; } },
    mile_per_hour:     { kind: "speed",    convert: function(ms) { return ms * 2.23694; } },
    knot:              { kind: "speed",    convert: function(ms) { return ms * 1.94384; } },
    beaufort:          { kind: "speed",    convert: function(ms) { return kts_to_beaufort(ms * 1.943844); } },
    mbar:              { kind: "press",    convert: function(hpa) { return hpa; } },
    hpa:               { kind: "press",    convert: function(hpa) { return hpa; } },
    kpa:               { kind: "press",    convert: function(hpa) { return hpa * 0.1; } },
    inhg:              { kind: "press",    convert: function(hpa) { return hpa * 0.02953; } },
    mmhg:              { kind: "press",    convert: function(hpa) { return hpa * 0.7500617; } },
    mm:                { kind: "rain",     convert: function(mm) { return mm; } },
    cm:                { kind: "rain",     convert: function(mm) { return mm / 10; } },
    inch:              { kind: "rain",     convert: function(mm) { return mm * 0.03937; } },
    mm_per_hour:       { kind: "rainrate", convert: function(mm) { return mm; } },
    cm_per_hour:       { kind: "rainrate", convert: function(mm) { return mm / 10; } },
    inch_per_hour:     { kind: "rainrate", convert: function(mm) { return mm * 0.03937; } },
    km:                { kind: "distance", convert: function(km) { return km; } },
    mile:              { kind: "distance", convert: function(km) { return km * 0.621371; } },
    nautical_mile:     { kind: "distance", convert: function(km) { return km * 0.539957; } },
    meter:             { kind: "altitude", convert: function(m) { return m; } },
    foot:              { kind: "altitude", convert: function(m) { return m * 3.28084; } },
    microgram_per_meter_cubed: { kind: "concentration", convert: function(ug) { return ug; } },
    milligram_per_meter_cubed: { kind: "concentration", convert: function(ug) { return ug / 1000; } },
    gram_per_meter_cubed:      { kind: "concentration", convert: function(ug) { return ug / 1000000; } },
};

function BU_metricWXToConfiguredUnit(kind, value, unitName) {
    var numericValue = parseFloat(value);
    var normalizedUnit = String(unitName || "").trim().toLowerCase();
    var converter = BU_METRICWX_TO_CONFIGURED_UNIT[normalizedUnit];
    if (!isFinite(numericValue) || !converter || converter.kind !== kind) {
        return null;
    }
    return converter.convert(numericValue);
}
// END MQTT CONFIGURED UNIT CONVERSION

// ============================================================================
// Chart unit classification & conversion
// ============================================================================
// Highcharts series JSON (homepage.json etc.) is pre-converted server-side
// by HighchartsJsonGenerator using weewx.units.Converter.fromSkinDict() -
// i.e. the SAME site-wide display unit as current conditions/snapshots, NOT
// forecast's separate fixed system. Each series carries a human-readable
// yAxis_label like "Temperature (\u00b0C)" or "Wind Speed (mph)", or (for
// range/windBarb series) a raw WeeWX unit name like "degree_C" / "mile_per_hour"
// in range_unit/obs_unit. BU_classifyChartUnit() reads either form and
// returns {kind, fromMetricWX} - a function converting a METRICWX value
// INTO that series' base unit, so we can invert it back to METRICWX, then
// forward into the user's chosen system using the same BU_SYS table above.
var BU_CHART_TO_METRICWX = {
    // temperature
    "\u00b0c": function(c) { return c; },
    "degree_c": function(c) { return c; },
    "\u00b0f": function(f) { return (f - 32) * 5 / 9; },
    "degree_f": function(f) { return (f - 32) * 5 / 9; },
    // wind speed
    "mph": function(mph) { return mph / 2.23694; },
    "mile_per_hour": function(mph) { return mph / 2.23694; },
    "km/h": function(kmh) { return kmh / 3.6; },
    "km_per_hour": function(kmh) { return kmh / 3.6; },
    "m/s": function(ms) { return ms; },
    "meter_per_second": function(ms) { return ms; },
    "kt": function(kt) { return kt / 1.94384; },
    "knot": function(kt) { return kt / 1.94384; },
    // pressure
    "hpa": function(h) { return h; },
    "mbar": function(h) { return h; },
    "kpa": function(kpa) { return kpa * 10; },
    "inhg": function(inhg) { return inhg / 0.02953; },
    // rain / rain rate
    "mm/hr": function(mm) { return mm; },
    "mm_per_hour": function(mm) { return mm; },
    "mm": function(mm) { return mm; },
    "cm/hr": function(cm) { return cm * 10; },
    "cm_per_hour": function(cm) { return cm * 10; },
    "cm": function(cm) { return cm * 10; },
    "in/hr": function(inch) { return inch / 0.03937; },
    "inch_per_hour": function(inch) { return inch / 0.03937; },
    "in": function(inch) { return inch / 0.03937; },
    "inch": function(inch) { return inch / 0.03937; },
    // distance (e.g. windrun)
    "km": function(km) { return km; },
    "kilometer": function(km) { return km; },
    "mi": function(mi) { return mi * 1.609344; },
    "mile": function(mi) { return mi * 1.609344; },
    // altitude
    "m": function(m) { return m; },
    "meter": function(m) { return m; },
    "metre": function(m) { return m; },
    "ft": function(ft) { return ft / 3.28084; },
    "foot": function(ft) { return ft / 3.28084; },
    "feet": function(ft) { return ft / 3.28084; },
};

function BU_chartUnitKind(unitToken) {
    var t = unitToken.toLowerCase();
    if (t.indexOf("c") !== -1 && (t === "\u00b0c" || t === "degree_c" || t === "c")) { return "temp"; }
    if (t === "\u00b0f" || t === "degree_f" || t === "f") { return "temp"; }
    if (t.indexOf("mph") !== -1 || t === "mile_per_hour") { return "speed"; }
    if (t === "km/h" || t === "km_per_hour" || t === "kph") { return "speed"; }
    if (t.indexOf("m/s") !== -1 || t === "meter_per_second" || t === "mps") { return "speed"; }
    if (t === "kt" || t === "knot" || t.indexOf("knot") !== -1) { return "speed"; }
    if (t.indexOf("hpa") !== -1 || t.indexOf("mbar") !== -1) { return "press"; }
    if (t.indexOf("kpa") !== -1) { return "press"; }
    if (t.indexOf("inhg") !== -1) { return "press"; }
    if (t.indexOf("mm/hr") !== -1 || t === "mm_per_hour" || t.indexOf("cm/hr") !== -1 || t === "cm_per_hour") { return "rainrate"; }
    if (t === "mm" || t.indexOf("millimeter") !== -1 || t === "cm") { return "rain"; }
    if (t.indexOf("in/hr") !== -1 || t === "inch_per_hour") { return "rainrate"; }
    if (t === "in" || t === "inch") { return "rain"; }
    if (t === "km" || t.indexOf("kilometer") !== -1) { return "distance"; }
    if (t === "mi" || t === "mile" || t.indexOf("mile") !== -1) { return "distance"; }
    if (t === "m" || t === "meter" || t === "metre") { return "altitude"; }
    if (t === "ft" || t === "foot" || t === "feet") { return "altitude"; }
    return null;
}

// Extract the unit token from a yAxis_label like "Temperature (\u00b0C)" ->
// "\u00b0c", or accept a raw WeeWX unit name like "degree_C" -> "degree_c" directly.
function BU_extractUnitToken(label) {
    if (!label) { return null; }
    var s = String(label);
    var m = s.match(/\(([^)]+)\)\s*$/);
    if (m) { return m[1].trim().toLowerCase(); }
    return s.trim().toLowerCase();
}

// Convert a single METRICWX value into the display system the user has
// chosen, given the chart series' detected physical "kind".
function BU_chartMetricWXToDisplay(kind, value) {
    var sysKey = BU_getSystem();
    var s = BU_SYS[sysKey];
    if (!s) { return value; }
    switch (kind) {
        case "temp":     return s.temp(value);
        case "speed":    return s.speed(value);
        case "press":    return s.press(value);
        case "rain":     return s.rain(value);
        case "rainrate": return s.rain(value);
        case "distance": return s.distance(value);
        case "altitude": return s.altitude(value);
        default:         return value;
    }
}

function BU_chartUnitLabelFor(kind) {
    var sysKey = BU_getSystem();
    var s = BU_SYS[sysKey];
    if (!s) { return ""; }
    switch (kind) {
        case "temp":     return s.tl;
        case "speed":    return s.sl;
        case "press":    return s.pl;
        case "rain":     return s.rl;
        case "rainrate": return s.rrl;
        case "distance": return s.dl;
        case "altitude": return s.al;
        default:         return "";
    }
}

// Convert a single chart value FROM its server-baked base unit TO METRICWX,
// THEN to the user's chosen display unit, in one step. unitToken can be
// either a yAxis_label-style "(\u00b0C)" string or a raw WeeWX unit name.
function BU_convertChartValue(value, unitToken) {
    var v = parseFloat(value);
    if (isNaN(v) || !unitToken) { return value; }
    var kind = BU_chartUnitKind(unitToken);
    if (!kind) { return value; }
    var toMetricFn = BU_CHART_TO_METRICWX[unitToken.toLowerCase()];
    var metricVal = toMetricFn ? toMetricFn(v) : v;
    return BU_chartMetricWXToDisplay(kind, metricVal);
}

function BU_getSystem() {
    var defaultKey = window.BU_DEFAULT_UNIT_SYSTEM || "metric";
    var key = defaultKey;
    if (window.BU_UNIT_SWITCHER_ENABLED) {
        try { key = localStorage.getItem("belchertown_unit_system") || defaultKey; } catch(e) {}
    }
    return BU_SYS[key] ? key : (BU_SYS[defaultKey] ? defaultKey : "metric");
}

function BU_fmt(v, dp) {
    if (v === null || v === undefined || isNaN(v)) { return null; }
    var decimals = parseInt(dp !== undefined ? dp : 1, 10);
    if (isNaN(decimals)) { decimals = 1; }
    return Number(v).toLocaleString("$system_locale_js", {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
    });
}

function BU_obsDecimals(obsName, fallback) {
    if (typeof unit_rounding_array === "object" && unit_rounding_array && unit_rounding_array.hasOwnProperty(obsName)) {
        var rounding = unit_rounding_array[obsName];
        if (rounding === "%d") { return 0; }
        var parsed = parseInt(rounding, 10);
        if (!isNaN(parsed)) { return parsed; }
    }
    return fallback;
}

function BU_setText(sel, val) {
    if (val === null || val === undefined) { return; }
    document.querySelectorAll(sel).forEach(function(el) { el.textContent = val; });
}

function BU_setHtml(sel, val) {
    if (val === null || val === undefined) { return; }
    document.querySelectorAll(sel).forEach(function(el) { el.innerHTML = val; });
}

// BEGIN ALWAYS-ON MQTT UNIT APPLICATION
var BU_UNIT_SWITCHER_MEASUREMENT_KINDS = {
    temp: true,
    speed: true,
    press: true,
    rain: true,
    rainrate: true,
    distance: true,
    altitude: true,
};

function BU_mqttDisplayMeasurement(value, kind, decimals, displayMeta) {
    var numericValue = parseFloat(value);
    if (!isFinite(numericValue)) { return null; }

    var converted;
    var label;
    var unitName = "";
    if (window.BU_UNIT_SWITCHER_ENABLED === true && BU_UNIT_SWITCHER_MEASUREMENT_KINDS[kind]) {
        converted = BU_chartMetricWXToDisplay(kind, numericValue);
        label = BU_chartUnitLabelFor(kind);
    } else {
        unitName = (displayMeta && displayMeta.unit_name) || BU_CONFIGURED_UNIT_NAMES[kind] || "";
        converted = BU_metricWXToConfiguredUnit(kind, numericValue, unitName);
        label = displayMeta && displayMeta.hasOwnProperty("unit_label")
            ? displayMeta.unit_label
            : BU_CONFIGURED_UNIT_LABELS[kind] || "";
    }

    var formatted = BU_fmt(converted, decimals);
    if (formatted === null) { return null; }
    return {
        numeric: converted,
        formatted: formatted,
        label: String(label || "").replace(/&nbsp;/g, " ").trim(),
        unitName: unitName,
    };
}

function BU_formatCurrentObservation(value, kind, decimals, displayMeta) {
    var measurement = BU_mqttDisplayMeasurement(value, kind, decimals, displayMeta);
    if (!measurement) { return null; }
    return measurement.formatted + (measurement.label ? "\u00a0" + measurement.label : "");
}

function BU_formatCurrentObservationTime(value) {
    var timestamp = parseFloat(value);
    if (!isFinite(timestamp) || typeof tzAdjustedMoment !== "function") { return null; }
    return tzAdjustedMoment(timestamp).format("L LTS");
}

function BU_stationObservationUnitMetadata(data) {
    return data &&
        data.station_observations &&
        data.station_observations.unit_switch &&
        typeof data.station_observations.unit_switch === "object"
        ? data.station_observations.unit_switch
        : null;
}

function BU_applyStationObservationUnitMetadata(metaByObs, valueResolver) {
    if (!metaByObs) { return; }
    Object.keys(metaByObs).forEach(function(obsName) {
        var meta = metaByObs[obsName];
        if (!meta || !meta.selector || !meta.kind) { return; }
        var rawValue = valueResolver ? valueResolver(obsName, meta) : meta.raw;
        var value = meta.kind === "time"
            ? BU_formatCurrentObservationTime(rawValue)
            : BU_formatCurrentObservation(rawValue, meta.kind, meta.decimals, meta);
        if (value !== null) {
            BU_setHtml(meta.selector, value);
        }
    });
}

function BU_mqttObservationValue(obsName, meta, packet) {
    if (!packet) { return null; }
    var keys = [];
    if (Array.isArray(meta.mqtt_keys)) {
        keys = keys.concat(meta.mqtt_keys);
    }
    var selectorName = meta.selector ? String(meta.selector).replace(/^\./, "") : "";
    var names = [obsName, selectorName];
    if (meta.kind === "time") {
        for (var timeIndex = 0; timeIndex < names.length; timeIndex++) {
            var timeKey = names[timeIndex];
            if (timeKey && packet[timeKey] !== undefined && packet[timeKey] !== null && packet[timeKey] !== "") {
                return packet[timeKey];
            }
        }
        return meta.raw;
    }
    for (var i = 0; i < keys.length; i++) {
        if (packet[keys[i]] !== undefined && packet[keys[i]] !== null && packet[keys[i]] !== "") {
            return packet[keys[i]];
        }
    }

    var suffixedValue = BU_mqttPacketMetricWXValue(
        packet,
        names,
        meta.kind,
        BU_mqttMetricSuffixes(meta.kind),
        null
    );
    if (suffixedValue !== null && suffixedValue !== undefined) {
        return suffixedValue;
    }

    var fallbackKeys = [obsName, selectorName];
    for (var j = 0; j < fallbackKeys.length; j++) {
        var fallbackKey = fallbackKeys[j];
        if (!fallbackKey || packet[fallbackKey] === undefined || packet[fallbackKey] === null || packet[fallbackKey] === "") {
            continue;
        }
        var fallbackValue = parseFloat(packet[fallbackKey]);
        if (isNaN(fallbackValue)) {
            continue;
        }
        if (meta.kind === "concentration") {
            return fallbackValue;
        }
        var label = "";
        if (typeof unit_label_array === "object" && unit_label_array) {
            label = unit_label_array[fallbackKey] || unit_label_array[obsName] || unit_label_array[selectorName] || "";
        }
        var token = BU_extractUnitToken(String(label || "").replace(/&nbsp;/g, " ").trim());
        var toMetricWX = token ? BU_CHART_TO_METRICWX[token] : null;
        if (toMetricWX) {
            return toMetricWX(fallbackValue);
        }
    }

    return meta.raw;
}

// BEGIN MQTT PAYLOAD NORMALIZATION
function BU_mqttMetricSuffixes(kind) {
    var suffixesByKind = {
        temp: [
            { suffix: "_C", toMetricWX: function(c) { return c; } },
            { suffix: "_F", toMetricWX: function(f) { return (f - 32) * 5 / 9; } },
        ],
        press: [
            { suffix: "_mbar", toMetricWX: function(hpa) { return hpa; } },
            { suffix: "_hPa", toMetricWX: function(hpa) { return hpa; } },
            { suffix: "_kPa", toMetricWX: function(kpa) { return kpa * 10; } },
            { suffix: "_inHg", toMetricWX: function(inhg) { return inhg / 0.02953; } },
            { suffix: "_mmHg", toMetricWX: function(mmhg) { return mmhg / 0.7500617; } },
        ],
        rain: [
            { suffix: "_mm", toMetricWX: function(mm) { return mm; } },
            { suffix: "_cm", toMetricWX: function(cm) { return cm * 10; } },
            { suffix: "_inch", toMetricWX: function(inch) { return inch / 0.03937; } },
        ],
        rainrate: [
            { suffix: "_mm_per_hour", toMetricWX: function(mm) { return mm; } },
            { suffix: "_cm_per_hour", toMetricWX: function(cm) { return cm * 10; } },
            { suffix: "_inch_per_hour", toMetricWX: function(inch) { return inch / 0.03937; } },
        ],
        speed: [
            { suffix: "_mps", toMetricWX: function(ms) { return ms; } },
            { suffix: "_kph", toMetricWX: function(kph) { return kph / 3.6; } },
            { suffix: "_mph", toMetricWX: function(mph) { return mph / 2.23694; } },
            { suffix: "_knot", toMetricWX: function(knot) { return knot / 1.94384; } },
            { suffix: "_beaufort", toMetricWX: function(beaufort) {
                var knots = beaufort_to_knots(beaufort);
                return knots === null ? NaN : knots / 1.94384;
            } },
        ],
        distance: [
            { suffix: "_km", toMetricWX: function(km) { return km; } },
            { suffix: "_mile", toMetricWX: function(mile) { return mile * 1.609344; } },
        ],
        altitude: [
            { suffix: "_meter", toMetricWX: function(meter) { return meter; } },
            { suffix: "_foot", toMetricWX: function(foot) { return foot / 3.28084; } },
        ],
        concentration: [
            { suffix: "_microgram_per_meter_cubed", toMetricWX: function(ug) { return ug; } },
            { suffix: "_milligram_per_meter_cubed", toMetricWX: function(mg) { return mg * 1000; } },
            { suffix: "_gram_per_meter_cubed", toMetricWX: function(g) { return g * 1000000; } },
        ],
    };
    return suffixesByKind[kind] || [];
}

function BU_mqttPacketMetricWXValue(packet, names, kind, rawSuffixes, fallbackRaw) {
    if (!packet) { return null; }
    rawSuffixes = rawSuffixes || [];
    for (var i = 0; i < names.length; i++) {
        for (var j = 0; j < rawSuffixes.length; j++) {
            var key = names[i] + rawSuffixes[j].suffix;
            if (packet[key] === undefined || packet[key] === null || packet[key] === "") {
                continue;
            }
            var rawValue = parseFloat(packet[key]);
            if (isNaN(rawValue)) {
                continue;
            }
            return rawSuffixes[j].toMetricWX(rawValue);
        }
    }

    for (var k = 0; k < names.length; k++) {
        var fallbackKey = names[k];
        if (!fallbackKey || packet[fallbackKey] === undefined || packet[fallbackKey] === null || packet[fallbackKey] === "") {
            continue;
        }
        var fallbackValue = parseFloat(packet[fallbackKey]);
        if (isNaN(fallbackValue)) {
            continue;
        }
        var label = "";
        if (typeof unit_label_array === "object" && unit_label_array) {
            label = unit_label_array[fallbackKey] || "";
        }
        var token = BU_extractUnitToken(String(label || "").replace(/&nbsp;/g, " ").trim());
        var toMetricWX = token ? BU_CHART_TO_METRICWX[token] : null;
        if (toMetricWX && BU_chartUnitKind(token) === kind) {
            return toMetricWX(fallbackValue);
        }
    }

    return fallbackRaw;
}
// END MQTT PAYLOAD NORMALIZATION

function BU_mqttTemperatureValue(packet, names, fallbackRaw) {
    return BU_mqttPacketMetricWXValue(packet, names, "temp", BU_mqttMetricSuffixes("temp"), fallbackRaw);
}

function BU_applyOutTempColor(displayValue, unitLabel, unitName) {
    if (displayValue === null || displayValue === undefined || isNaN(displayValue)) { return; }
    var normalizedName = String(unitName || "").trim().toLowerCase();
    if (normalizedName === "degree_f" || unitLabel === "\u00b0F") {
        get_outTemp_color("degree_F", displayValue);
    } else if (normalizedName === "degree_c" || unitLabel === "\u00b0C") {
        get_outTemp_color("degree_C", displayValue);
    }
}

// MQTT values are normalized on every live update. The optional unit switcher
// only selects the target system; with it disabled, the configured WeeWX units
// embedded above remain the target.
function BU_applyMQTT(data) {
    if (!data) { return; }

    var tC = BU_mqttTemperatureValue(data, ["outTemp"], null);
    var outTemp = BU_mqttDisplayMeasurement(tC, "temp", BU_obsDecimals("outTemp", 1));
    if (outTemp) {
        BU_setHtml(".outtemp", outTemp.formatted);
        BU_setText(".outtempunitlabelsuper", outTemp.label);
        BU_applyOutTempColor(outTemp.numeric, outTemp.label, outTemp.unitName);
    }

    var appC = BU_mqttTemperatureValue(data, ["appTemp"], null);
    var appTemp = BU_mqttDisplayMeasurement(appC, "temp", BU_obsDecimals("appTemp", 1));
    if (appTemp) {
        BU_setText(".feelslike", belchertown_label_text("$obs.label.feels_like") + " " + appTemp.formatted + (appTemp.label ? "\u00a0" + appTemp.label : ""));
    }

    var wcC = BU_mqttTemperatureValue(data, ["windchill"], null);
    var windchill = BU_mqttDisplayMeasurement(wcC, "temp", BU_obsDecimals("windchill", 1));
    if (windchill) {
        BU_setText(".curwindchill", windchill.formatted + (windchill.label ? "\u00a0" + windchill.label : ""));
    }

    var dpC = BU_mqttTemperatureValue(data, ["dewpoint"], null);
    var dewpoint = BU_mqttDisplayMeasurement(dpC, "temp", BU_obsDecimals("dewpoint", 1));
    if (dewpoint) {
        BU_setText(".dewpoint", dewpoint.formatted + (dewpoint.label ? "\u00a0" + dewpoint.label : ""));
    }

    var wsMs = BU_mqttPacketMetricWXValue(data, ["windSpeed"], "speed", BU_mqttMetricSuffixes("speed"), null);
    var windSpeed = BU_mqttDisplayMeasurement(wsMs, "speed", BU_obsDecimals("windSpeed", 0));
    if (windSpeed) {
        BU_setHtml(".curwindspeed", windSpeed.formatted);
        BU_setText(".mph", windSpeed.label);
    }

    var wgMs = BU_mqttPacketMetricWXValue(data, ["windGust"], "speed", BU_mqttMetricSuffixes("speed"), null);
    var windGust = BU_mqttDisplayMeasurement(wgMs, "speed", BU_obsDecimals("windGust", 0));
    if (windGust) {
        BU_setHtml(".curwindgust", windGust.formatted);
    }

    var bMb = BU_mqttPacketMetricWXValue(data, ["barometer"], "press", BU_mqttMetricSuffixes("press"), null);
    var barometer = BU_mqttDisplayMeasurement(bMb, "press", BU_obsDecimals("barometer", 3));
    if (barometer) {
        BU_setHtml(".barometer", barometer.formatted + (barometer.label ? "\u00a0" + barometer.label : ""));
    }

    var drMm = BU_mqttPacketMetricWXValue(data, ["dayRain"], "rain", BU_mqttMetricSuffixes("rain"), null);
    var dayRain = BU_mqttDisplayMeasurement(drMm, "rain", BU_obsDecimals("dayRain", 2));
    if (dayRain) {
        BU_setHtml(".dayRain", dayRain.formatted + (dayRain.label ? "\u00a0" + dayRain.label : ""));
    }

    var rrMm = BU_mqttPacketMetricWXValue(data, ["rainRate"], "rainrate", BU_mqttMetricSuffixes("rainrate"), null);
    var rainRate = BU_mqttDisplayMeasurement(rrMm, "rainrate", BU_obsDecimals("rainRate", 2));
    if (rainRate) {
        BU_setHtml(".rainRate", rainRate.formatted + (rainRate.label ? "\u00a0" + rainRate.label : ""));
    }

    BU_applyStationObservationUnitMetadata(BU_stationObservationUnitMetadata(weewx_data), function(obsName, meta) {
        return BU_mqttObservationValue(obsName, meta, data);
    });
}
// END ALWAYS-ON MQTT UNIT APPLICATION

#if $unitSwitcherJsEnabled

// ── Re-render daily high/low and max gust from current weewx_data ──────────
function BU_applyCurrent(data) {
    if (!data) { return; }
    var sysKey = BU_getSystem();
    var s = BU_SYS[sysKey];
    var cur = data["current"] || {};
    var day = data["day"] || {};

    // ── Current temperature ─────────────────────────────────────────────
    var tC = parseFloat(cur.outTemp_raw);
    if (tC !== null && tC !== undefined && !isNaN(tC)) {
        var outTemp = BU_fmt(s.temp(tC), BU_obsDecimals("outTemp", 1));
        BU_setHtml(".outtemp", outTemp);
        BU_setText(".outtempunitlabelsuper", s.tl);
        BU_applyOutTempColor(outTemp, s.tl);
    }

    var appC = parseFloat(cur.appTemp_raw);
    if (appC !== null && appC !== undefined && !isNaN(appC)) {
        BU_setText(".feelslike", belchertown_label_text("$obs.label.feels_like") + " " + BU_fmt(s.temp(appC), BU_obsDecimals("appTemp", 1)) + "\u00a0" + s.tl);
    }

    var wcC = parseFloat(cur.windchill_raw);
    if (wcC !== null && wcC !== undefined && !isNaN(wcC)) { BU_setText(".curwindchill", BU_fmt(s.temp(wcC), BU_obsDecimals("windchill", 1)) + "\u00a0" + s.tl); }

    var dpC = parseFloat(cur.dewpoint_raw);
    if (dpC !== null && dpC !== undefined && !isNaN(dpC)) { BU_setText(".dewpoint", BU_fmt(s.temp(dpC), BU_obsDecimals("dewpoint", 1)) + "\u00a0" + s.tl); }

    // ── Current wind ─────────────────────────────────────────────────────
    var wsMs = parseFloat(cur.windspeed_raw);
    var wgMs = parseFloat(cur.windGust_raw);
    if (!isNaN(wsMs)) { BU_setHtml(".curwindspeed", BU_fmt(s.speed(wsMs), BU_obsDecimals("windSpeed", 0))); BU_setText(".mph", s.sl); }
    if (!isNaN(wgMs)) { BU_setHtml(".curwindgust",  BU_fmt(s.speed(wgMs), BU_obsDecimals("windGust", 0))); }

    // ── Current pressure ────────────────────────────────────────────────
    var bMb = parseFloat(cur.barometer_raw);
    if (!isNaN(bMb)) { BU_setHtml(".barometer", BU_fmt(s.press(bMb), BU_obsDecimals("barometer", 3)) + "\u00a0" + s.pl); }

    // ── Current rain ─────────────────────────────────────────────────────
    var drMm = parseFloat(cur.dayRain_raw);
    var rrMm = parseFloat(cur.rainRate_raw);
    if (!isNaN(drMm)) { BU_setHtml(".dayRain",  BU_fmt(s.rain(drMm), BU_obsDecimals("dayRain", 2)) + "\u00a0" + s.rl);  }
    if (!isNaN(rrMm)) { BU_setHtml(".rainRate", BU_fmt(s.rain(rrMm), BU_obsDecimals("rainRate", 2)) + "\u00a0" + s.rrl); }

    // ── Daily high/low/gust ──────────────────────────────────────────────
    var hiC = parseFloat((day.outTemp || {}).max_raw);
    var loC = parseFloat((day.outTemp || {}).min_raw);
    if (!isNaN(hiC)) { BU_setHtml(".high", BU_fmt(s.temp(hiC), BU_obsDecimals("outTemp", 1)) + "\u00a0" + s.tl); }
    if (!isNaN(loC)) { BU_setHtml(".low",  BU_fmt(s.temp(loC), BU_obsDecimals("outTemp", 1)) + "\u00a0" + s.tl); }

    var gustMs = parseFloat((day.wind || {}).max_raw);
    if (!isNaN(gustMs)) { BU_setHtml(".dailymaxgust", BU_fmt(s.speed(gustMs), BU_obsDecimals("windGust", 0))); }

    BU_applyStationObservationUnitMetadata(BU_stationObservationUnitMetadata(data));
}

// ── Re-render the daily/weekly/yesterday snapshot grid ─────────────────────
function BU_applySnapshot(data, key, prefix) {
    if (!data) { return; }
    var d = data[key];
    if (!d) { return; }
    var sysKey = BU_getSystem();
    var s = BU_SYS[sysKey];

    var hiC = parseFloat((d.outTemp || {}).max_raw);
    var loC = parseFloat((d.outTemp || {}).min_raw);
    if (!isNaN(hiC)) { BU_setHtml("." + prefix + "high", BU_fmt(s.temp(hiC), BU_obsDecimals("outTemp", 1)) + "\u00a0" + s.tl); }
    if (!isNaN(loC)) { BU_setHtml("." + prefix + "low",  BU_fmt(s.temp(loC), BU_obsDecimals("outTemp", 1)) + "\u00a0" + s.tl); }

    var wAvgMs = parseFloat((d.wind || {}).avg_raw);
    var wMaxMs = parseFloat((d.wind || {}).max_raw);
    if (!isNaN(wAvgMs)) { BU_setHtml("." + prefix + "windavg", BU_fmt(s.speed(wAvgMs), BU_obsDecimals("windSpeed", 0)) + "\u00a0" + s.sl); }
    if (!isNaN(wMaxMs)) { BU_setHtml("." + prefix + "windmax", BU_fmt(s.speed(wMaxMs), BU_obsDecimals("windGust", 0)) + "\u00a0" + s.sl); }

    var rSumMm = parseFloat((d.rain || {}).sum_raw);
    var rMaxMm = parseFloat((d.rain || {}).max_raw);
    if (!isNaN(rSumMm)) { BU_setHtml("." + prefix + "rain",     BU_fmt(s.rain(rSumMm), BU_obsDecimals("rain", 2)) + "\u00a0" + s.rl);  }
    if (!isNaN(rMaxMm)) { BU_setHtml("." + prefix + "rainrate", BU_fmt(s.rain(rMaxMm), BU_obsDecimals("rainRate", 2)) + "\u00a0" + s.rrl); }
}

function BU_applyDailySnapshot(data, key) { BU_applySnapshot(data, key, "dailystats"); }
function BU_applyMonthlySnapshot(data, key) { BU_applySnapshot(data, key, "monthstats"); }

// ── Re-apply everything we know about when the user switches systems ───────
function BU_reapplyAll() {
    if (typeof weewx_data === "object" && weewx_data) {
        BU_applyCurrent(weewx_data);
        var daySelectEl = document.getElementById("snapshot-day-select");
        var dayKey = (daySelectEl && daySelectEl.value) || "day";
        BU_applyDailySnapshot(weewx_data, dayKey);
        var monthSelectEl = document.getElementById("snapshot-month-select");
        var monthKey = (monthSelectEl && monthSelectEl.value) || "month";
        BU_applyMonthlySnapshot(weewx_data, monthKey);
    }
    if (window.BU_lastMQTT) { BU_applyMQTT(window.BU_lastMQTT); }
    if (typeof window.BU_reapplyForecast === "function") { window.BU_reapplyForecast(); }
    if (typeof window.BU_reapplyCharts === "function") { window.BU_reapplyCharts(); }

    // Homepage's mini-charts only render once they scroll into view
    // (belchertown_run_when_visible). If the user switches units before
    // scrolling that far, BU_lastChartsRaw has nothing cached for that
    // chartgroup yet. Force it to render now with forceRender=true so it
    // picks up the just-changed unit on its first (and only) render -
    // BU_convertSeriesUnits reads the current system fresh from
    // localStorage, so this naturally renders correctly without needing
    // BU_reapplyCharts to find it afterward.
    if (typeof window.renderHomepageCharts === "function") {
        window.renderHomepageCharts(true);
    }
}

window.addEventListener("belchertownUnitsChanged", BU_reapplyAll);

// ── Sitewide header-temperature init ────────────────────────────────────
// update_weewx_data() (which populates the global `weewx_data` BU_reapplyAll
// reads from) was previously only ever called from index_html.tmpl's own
// inline script - meaning every other page (records, reports, charts,
// about...) left `weewx_data` empty, so switching units there had nothing
// to convert the header's .outtemp span from and it stayed stuck in
// whatever unit the report was generated in.
//
// Rather than invoke the full update_weewx_data() here (which also drives
// homepage-only things like the almanac diagram and snapshot panels),
// just fetch weewx_data.json and apply the unit-aware conversion directly -
// the same thing BU_reapplyAll() does once weewx_data is populated.
if (typeof ajaxweewx === "function") {
    ajaxweewx().then(function(data) {
        if (typeof weewx_data !== "object" || !weewx_data) {
            weewx_data = data;
        }
        BU_applyCurrent(data);
    }).catch(function(e) {});
}

