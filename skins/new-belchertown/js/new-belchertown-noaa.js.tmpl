// ── NOAA Report Unit Converter ────────────────────────────────────────────
// Called after populatePre() sets #noaa_contents text. Parses the
// fixed-width ASCII table line-by-line and converts numeric columns
// from the site's base unit (°C, mph, mm) to the user's chosen system.
//
// Base units (from template analysis):
//   Temperature: °C    (from $day.outTemp etc via WeeWX unit converter)
//   Wind speed:  mph   (confirmed from your site's "WIND SPEED (mph)" header)
//   Rain:        mm    (confirmed from your site's "RAIN (mm)" header)
//   Pressure:    hPa   (not in NOAA reports)
//   Degree-days: C-days or F-days (conversion requires setpoint, so SKIPPED)
//
// Detects base units dynamically from the report header line:
//   "TEMPERATURE (°C), RAIN (mm), WIND SPEED (mph)"

(function() {

// ── Unit conversion table (same logic as BU_SYS, no dependency on it) ──
var NOAA_CONV = {
    temp: {
        base_from_C: function(c) { return c; },   // site base is already C
        us:          function(c) { return c*9/5+32; },
        uk:          function(c) { return c; },
        metric:      function(c) { return c; },
        scandinavia: function(c) { return c; },
        canada:      function(c) { return c; },
        aviation:    function(c) { return c; },
    },
    speed: {
        base_from_ms: function(mph) { return mph / 2.23694; },  // base is mph
        us:           function(ms) { return ms * 2.23694; },
        uk:           function(ms) { return ms * 2.23694; },
        metric:       function(ms) { return ms * 3.6; },
        scandinavia:  function(ms) { return ms; },
        canada:       function(ms) { return ms * 3.6; },
        aviation:     function(ms) { return ms * 1.94384; },
    },
    rain: {
        base_from_mm: function(mm) { return mm; },    // base is mm
        us:           function(mm) { return mm * 0.03937; },
        uk:           function(mm) { return mm; },
        metric:       function(mm) { return mm; },
        scandinavia:  function(mm) { return mm; },
        canada:       function(mm) { return mm; },
        aviation:     function(mm) { return mm; },
    },
};

function noaa_convert(kind, val, dst) {
    var v = parseFloat(val);
    if (isNaN(v)) { return null; }
    var c = NOAA_CONV[kind];
    var metricwx;
    if (kind === 'temp')  { metricwx = c.base_from_C(v); }
    if (kind === 'speed') { metricwx = c.base_from_ms(v); }
    if (kind === 'rain')  { metricwx = c.base_from_mm(v); }
    if (!c[dst]) { return v; }
    return c[dst](metricwx);
}

function noaa_fmt(val, kind, dst) {
    if (val === null || isNaN(val)) { return null; }
    if (kind === 'temp') {
        return (val >= 0 ? '' : '') + val.toFixed(1);
    }
    if (kind === 'rain') {
        return dst === 'us' ? val.toFixed(2) : val.toFixed(1);
    }
    // speed
    if (dst === 'scandinavia') { return val.toFixed(1); }
    if (dst === 'aviation') { return val.toFixed(1); }
    return val.toFixed(1);
}

// Replace the numeric part of a captured group, preserving width
function noaa_sub(group, kind, dst) {
    var numMatch = group.match(/(-?\d+\.?\d*)/);
    if (!numMatch) { return group; }
    var converted = noaa_convert(kind, numMatch[1], dst);
    if (converted === null) { return group; }
    var formatted = noaa_fmt(converted, kind, dst);
    // Right-justify in same width as original group
    var width = group.length;
    while (formatted.length < width) { formatted = ' ' + formatted; }
    return formatted;
}

// ── Section discriminator for yearly reports ─────────────────────────────
// Yearly reports have three fixed-width table sections separated by blank
// lines / dashes. We detect which section we're in from the header lines.
var TEMP_HEADER_RE   = /TEMPERATURE/;
var RAIN_HEADER_RE   = /PRECIPITATION/;
var WIND_HEADER_RE   = /WIND\s+SPEED/;
var DIVIDER_RE       = /^-{10,}/;
var BLANK_RE         = /^\s*$/;

// ── Monthly patterns ──────────────────────────────────────────────────────
var MONTHLY_DATA_RE = new RegExp(
    '^( {1,2}\\d{1,2})'           // day
    + '([ -]?\\s*\\d+\\.\\d+)'    // avg_temp   -> TEMP
    + '([ -]?\\s*\\d+\\.\\d+)'    // hi_temp    -> TEMP
    + '(\\s+\\d{2}:\\d{2})'       // hi_time    skip
    + '([ -]?\\s*\\d+\\.\\d+)'    // lo_temp    -> TEMP
    + '(\\s+\\d{2}:\\d{2})'       // lo_time    skip
    + '([ -]?\\s*\\d+\\.\\d+)'    // heatdeg    SKIP
    + '([ -]?\\s*\\d+\\.\\d+)'    // cooldeg    SKIP
    + '([ -]?\\s*\\d+\\.\\d+)'    // rain       -> RAIN
    + '([ -]?\\s*\\d+\\.\\d+)'    // wind_avg   -> SPEED
    + '([ -]?\\s*\\d+\\.\\d+)'    // wind_hi    -> SPEED
    + '(\\s+\\d{2}:\\d{2})'       // wind_time  skip
    + '(\\s+\\d+)'                // wind_dir   skip
);

var MONTHLY_SUMM_RE = new RegExp(
    '^(\\s{3,})'                   // leading spaces (no day number)
    + '([ -]?\\s*\\d+\\.\\d+)'    // avg_temp   -> TEMP
    + '([ -]?\\s*\\d+\\.\\d+)'    // hi_temp    -> TEMP
    + '(\\s+\\d+)'                 // hi_day     skip
    + '([ -]?\\s*\\d+\\.\\d+)'    // lo_temp    -> TEMP
    + '(\\s+\\d+)'                 // lo_day     skip
    + '([ -]?\\s*\\d+\\.\\d+)'    // heatdeg    SKIP
    + '([ -]?\\s*\\d+\\.\\d+)'    // cooldeg    SKIP
    + '([ -]?\\s*\\d+\\.\\d+)'    // rain       -> RAIN
    + '([ -]?\\s*\\d+\\.\\d+)'    // wind_avg   -> SPEED
    + '([ -]?\\s*\\d+\\.\\d+)'    // wind_hi    -> SPEED
    + '(\\s+\\d+)'                 // wind_hi_day skip
    + '(\\s+\\d+)'                 // wind_dir   skip
);

// ── Yearly patterns ───────────────────────────────────────────────────────
// All start with "YYYY MM" (7 chars)
var YR_PREFIX = '^(\\d{4} \\d{2})';

var YEARLY_TEMP_RE = new RegExp(
    YR_PREFIX
    + '([ -]?\\s*\\d+\\.\\d+)'    // meanmax -> TEMP
    + '([ -]?\\s*\\d+\\.\\d+)'    // meanmin -> TEMP
    + '([ -]?\\s*\\d+\\.\\d+)'    // avg     -> TEMP
    + '([ -]?\\s*\\d+\\.\\d+)'    // heatdeg SKIP
    + '([ -]?\\s*\\d+\\.\\d+)'    // cooldeg SKIP
    + '(\\s+)'
    + '([ -]?\\s*\\d+\\.\\d+)'    // hi_temp -> TEMP
    + '(\\s+\\d+)'                 // hi_day  skip
    + '(\\s+)'
    + '([ -]?\\s*-?\\d+\\.\\d+)'  // lo_temp -> TEMP (may be negative)
    + '(\\s+\\d+)'                 // lo_day  skip
    // counts follow - skip
);

var YEARLY_RAIN_RE = new RegExp(
    YR_PREFIX
    + '([ -]?\\s*\\d+\\.\\d+)'    // total   -> RAIN
    + '([ -]?\\s*\\d+\\.\\d+)'    // max_day -> RAIN
    // rest skip
);

var YEARLY_WIND_RE = new RegExp(
    YR_PREFIX
    + '([ -]?\\s*\\d+\\.\\d+)'    // avg -> SPEED
    + '([ -]?\\s*\\d+\\.\\d+)'    // hi  -> SPEED
    // rest skip
);

// Detect whether this is a monthly or yearly report from first section header
function detect_report_type(text) {
    if (/MONTHLY CLIMATOLOGICAL SUMMARY/.test(text)) { return 'monthly'; }
    if (/CLIMATOLOGICAL SUMMARY for year/.test(text)) { return 'yearly'; }
    return 'unknown';
}

// Detect base units from the header line in the report
function detect_base_units(text) {
    var base = { temp: 'C', speed: 'mph', rain: 'mm' };
    var m = text.match(/TEMPERATURE \(([^)]+)\)/);
    if (m && m[1].indexOf('F') !== -1) { base.temp = 'F'; }
    m = text.match(/WIND SPEED \(([^)]+)\)/);
    if (m) {
        var spd = m[1].toLowerCase();
        if (spd.indexOf('m/s') !== -1) { base.speed = 'ms'; }
        else if (spd.indexOf('km') !== -1) { base.speed = 'kmh'; }
        else if (spd.indexOf('kt') !== -1) { base.speed = 'kt'; }
        // else mph (default)
    }
    m = text.match(/RAIN \(([^)]+)\)/);
    if (m && m[1].toLowerCase() === 'in') { base.rain = 'in'; }
    return base;
}

// Apply detected base unit to the conversion table
function apply_base_units(base) {
    if (base.temp === 'F') {
        NOAA_CONV.temp.base_from_C = function(f) { return (f - 32) * 5 / 9; };
    }
    if (base.speed === 'ms') {
        NOAA_CONV.speed.base_from_ms = function(ms) { return ms; };
    } else if (base.speed === 'kmh') {
        NOAA_CONV.speed.base_from_ms = function(kmh) { return kmh / 3.6; };
    } else if (base.speed === 'kt') {
        NOAA_CONV.speed.base_from_ms = function(kt) { return kt / 1.94384; };
    }
    if (base.rain === 'in') {
        NOAA_CONV.rain.base_from_mm = function(inch) { return inch * 25.4; };
    }
}

// Update the report's own unit header line to show new units
function update_unit_header(line, dst) {
    var UNIT_LABELS = {
        temp:  { us: '°F', uk: '°C', metric: '°C', scandinavia: '°C', canada: '°C', aviation: '°C' },
        speed: { us: 'mph', uk: 'mph', metric: 'km/h', scandinavia: 'm/s', canada: 'km/h', aviation: 'kt' },
        rain:  { us: 'in', uk: 'mm', metric: 'mm', scandinavia: 'mm', canada: 'mm', aviation: 'mm' },
    };
    line = line.replace(/TEMPERATURE \([^)]+\)/, 'TEMPERATURE (' + UNIT_LABELS.temp[dst] + ')');
    line = line.replace(/WIND SPEED \([^)]+\)/, 'WIND SPEED (' + UNIT_LABELS.speed[dst] + ')');
    line = line.replace(/RAIN \([^)]+\)/, 'RAIN (' + UNIT_LABELS.rain[dst] + ')');
    line = line.replace(/PRECIPITATION \([^)]+\)/, 'PRECIPITATION (' + UNIT_LABELS.rain[dst] + ')');
    return line;
}

function convert_monthly_line(line, dst) {
    var m = MONTHLY_DATA_RE.exec(line);
    if (m) {
        var g = m.slice(1);  // groups 1-13
        g[1] = noaa_sub(g[1], 'temp', dst);
        g[2] = noaa_sub(g[2], 'temp', dst);
        g[4] = noaa_sub(g[4], 'temp', dst);
        // g[6] heatdeg SKIP
        // g[7] cooldeg SKIP
        g[8] = noaa_sub(g[8], 'rain', dst);
        g[9] = noaa_sub(g[9], 'speed', dst);
        g[10] = noaa_sub(g[10], 'speed', dst);
        return g.join('');
    }
    m = MONTHLY_SUMM_RE.exec(line);
    if (m) {
        var g = m.slice(1);
        g[1] = noaa_sub(g[1], 'temp', dst);
        g[2] = noaa_sub(g[2], 'temp', dst);
        g[4] = noaa_sub(g[4], 'temp', dst);
        g[8] = noaa_sub(g[8], 'rain', dst);
        g[9] = noaa_sub(g[9], 'speed', dst);
        g[10] = noaa_sub(g[10], 'speed', dst);
        return g.join('');
    }
    return line;
}

function convert_yearly_line(line, section, dst) {
    if (section === 'temp') {
        var m = YEARLY_TEMP_RE.exec(line);
        if (m) {
            var g = m.slice(1);
            g[1] = noaa_sub(g[1], 'temp', dst);  // meanmax
            g[2] = noaa_sub(g[2], 'temp', dst);  // meanmin
            g[3] = noaa_sub(g[3], 'temp', dst);  // avg
            // g[4] heatdeg SKIP g[5] cooldeg SKIP
            g[7] = noaa_sub(g[7], 'temp', dst);  // hi_temp
            g[10] = noaa_sub(g[10], 'temp', dst); // lo_temp
            return g.join('');
        }
    } else if (section === 'rain') {
        var m = YEARLY_RAIN_RE.exec(line);
        if (m) {
            var g = m.slice(1);
            var rest = line.slice(m[0].length);
            g[1] = noaa_sub(g[1], 'rain', dst);
            g[2] = noaa_sub(g[2], 'rain', dst);
            return g.join('') + rest;
        }
    } else if (section === 'wind') {
        var m = YEARLY_WIND_RE.exec(line);
        if (m) {
            var g = m.slice(1);
            var rest = line.slice(m[0].length);
            g[1] = noaa_sub(g[1], 'speed', dst);
            g[2] = noaa_sub(g[2], 'speed', dst);
            return g.join('') + rest;
        }
    }
    return line;
}

// ── Main conversion function ─────────────────────────────────────────────
window.BU_convertNoaaReport = function(text, dst) {
    if (!dst || dst === 'uk' || (typeof BU_SYS !== 'undefined' && !BU_SYS[dst])) {
        // 'uk' is the same as the site base (°C, mph, mm) - no conversion needed
        // unless it's actually different; check via BU_SYS
    }

    var type = detect_report_type(text);
    if (type === 'unknown') { return text; }

    var base = detect_base_units(text);
    apply_base_units(base);

    var lines = text.split('\n');
    var result = [];
    var section = 'temp';  // for yearly: which of the 3 sections we're in

    for (var i = 0; i < lines.length; i++) {
        var line = lines[i];

        // Update the unit header line
        if (/TEMPERATURE.*RAIN.*WIND/.test(line) || 
            /TEMPERATURE \(/.test(line) || 
            /PRECIPITATION \(/.test(line) ||
            /WIND SPEED \(/.test(line)) {
            result.push(update_unit_header(line, dst));
            continue;
        }

        // For yearly: track which section we're in
        if (type === 'yearly') {
            if (TEMP_HEADER_RE.test(line)) { section = 'temp'; }
            else if (RAIN_HEADER_RE.test(line)) { section = 'rain'; }
            else if (WIND_HEADER_RE.test(line)) { section = 'wind'; }
        }

        if (type === 'monthly') {
            result.push(convert_monthly_line(line, dst));
        } else {
            result.push(convert_yearly_line(line, section, dst));
        }
    }

    return result.join('\n');
};

// BU_reapplyNoaa is defined in reports/index.html.tmpl alongside the XHR,
// where it can call setReportText() directly without any observer machinery.

})();
